{% extends app.user ? 'layouts/dashboard.html.twig' : 'base.html.twig' %}

{% block title %}Page Not Found | {{ company_name ?? 'ModularSaaS' }}{% endblock %}

{# If logged in (dashboard layout) #}
{% block content_title %}Page Not Found{% endblock %}
{% block content_subtitle %}The page you requested could not be found or you do not have permission to view it.{% endblock %}

{% block content_actions %}
{% endblock %}

{% block main_content %}
    {# Render the error card inside the dashboard content area with dark mode support #}
    <div class="rounded-2xl p-10 shadow-sm text-center max-w-lg mx-auto my-6" style="background-color: rgba(30, 41, 59, 0.6); border: 1px solid rgba(51, 65, 85, 0.8);">
        <!-- Big Code -->
        <div style="font-size: 6rem; font-weight: 900; color: #f43f5e; line-height: 1; margin-bottom: 1.5rem; letter-spacing: -0.025em;">404</div>

        <!-- Icon -->
        <div class="rounded-2xl flex items-center justify-center mx-auto mb-6" style="width: 4.5rem; height: 4.5rem; background-color: rgba(225, 29, 72, 0.1); border: 1px solid rgba(225, 29, 72, 0.2);">
            <i data-lucide="alert-octagon" class="w-9 h-9 text-rose-500"></i>
        </div>

        <!-- Title -->
        <h2 class="text-2xl font-bold text-white tracking-tight mb-3 leading-tight">
            Access Denied / Not Found
        </h2>

        <!-- Description -->
        <p class="text-slate-300 text-sm leading-relaxed mb-8">
            The page you are looking for does not exist, has been removed, or your account does not have sufficient permission to access it.
        </p>

        <!-- Actions -->
        <div>
            <a href="{{ path('app_dashboard') }}" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.875rem 2.5rem; font-size: 1rem; font-weight: 700; color: #fff; background-color: #4f46e5; border-radius: 0.75rem; text-decoration: none; transition: background-color 0.15s; box-shadow: 0 4px 12px rgba(99,102,241,0.4);" onmouseover="this.style.backgroundColor='#4338ca'" onmouseout="this.style.backgroundColor='#4f46e5'">
                <i data-lucide="home" style="width: 1.1rem; height: 1.1rem;"></i>
                <span>Back to Dashboard</span>
            </a>
        </div>
    </div>
{% endblock %}

{# If not logged in (standalone layout) #}
{% block body %}
    {% if app.user %}
        {{ parent() }}
    {% else %}
        <div class="min-h-screen flex items-center justify-center px-4 relative overflow-hidden bg-slate-50 dark:bg-slate-900">
            <!-- Decorative background elements -->
            <div class="absolute top-1/5 left-1/5 w-96 h-96 bg-indigo-500/5 dark:bg-indigo-500/10 rounded-full blur-3xl"></div>
            <div class="absolute bottom-1/5 right-1/5 w-96 h-96 bg-red-500/5 dark:bg-red-500/10 rounded-full blur-3xl"></div>

            <div class="max-w-md w-full relative z-10 p-4">
                <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl p-10 shadow-xl text-center">
                    <!-- 404 Big Badge -->
                    <div style="font-size: 7rem; font-weight: 900; color: #ef4444; line-height: 1; margin-bottom: 1rem; letter-spacing: -0.025em;">
                        404
                    </div>

                    <!-- Icon -->
                    <div class="w-16 h-16 bg-red-50 dark:bg-red-950/30 border border-red-100 dark:border-red-900/30 rounded-2xl flex items-center justify-center mx-auto mb-6">
                        <i data-lucide="alert-octagon" class="w-8 h-8 text-red-500"></i>
                    </div>

                    <!-- Title -->
                    <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 tracking-tight mb-3 leading-tight">
                        Page Not Found
                    </h1>

                    <!-- Description -->
                    <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed mb-8">
                        The page you are looking for does not exist, has been removed, or you do not have permission to view it.
                    </p>

                    <!-- Actions -->
                    <div>
                        <a href="{{ path('app_dashboard') }}" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.875rem 2.5rem; font-size: 1rem; font-weight: 700; color: #fff; background-color: #4f46e5; border-radius: 0.75rem; text-decoration: none; transition: background-color 0.15s; box-shadow: 0 4px 12px rgba(99,102,241,0.4);" onmouseover="this.style.backgroundColor='#4338ca'" onmouseout="this.style.backgroundColor='#4f46e5'">
                            <i data-lucide="home" style="width: 1.1rem; height: 1.1rem;"></i>
                            <span>Back to Dashboard</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>
{% endblock %}
