{% extends 'layouts/dashboard.html.twig' %}

{% block title %}{{ 'Client Details'|module_term }} | {{ company_name ?? 'ModularSaaS' }}{% endblock %}

{% block content_title %}{{ 'Client Details'|module_term }}{% endblock %}
{% block content_subtitle %}{{ client.name }}{% endblock %}

{% block content_actions %}
    <a href="{{ path('app_clients_index') }}" class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 rounded-md shadow-sm transition-colors">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        <span>Return</span>
    </a>
    {% if is_granted('edit.clients') %}
    <a href="{{ path('app_clients_edit', {'slug': client.slug}) }}" class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-md shadow-sm transition-colors">
        <i data-lucide="pencil" class="w-4 h-4 text-white"></i>
        <span>Edit</span>
    </a>
    {% endif %}
    {% if is_granted('delete.clients') %}
    <button type="button" onclick="document.getElementById('deleteClientModal').showModal()" class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium text-white rounded-md shadow-sm transition-colors" style="background-color: #dc2626;">
        <i data-lucide="trash-2" class="w-4 h-4 text-white"></i>
        <span>Delete Account</span>
    </button>
    
    <dialog id="deleteClientModal" style="margin:auto;" class="p-0 rounded-lg shadow-xl border border-slate-200 backdrop:bg-slate-600/20 backdrop:backdrop-blur-[2px] open:animate-in open:fade-in open:zoom-in-95 duration-200 overflow-hidden">
        <div class="bg-white max-w-md w-full overflow-hidden text-left">
            <div class="p-6">
                <div class="flex items-start gap-4 mb-5">
                    <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
                        <i data-lucide="alert-circle" class="w-5 h-5 text-red-600"></i>
                    </div>
                    <div class="flex-1">
                        <h3 class="text-lg font-bold text-slate-900 leading-none mb-2">Delete {{ client.name }}?</h3>
                        <p class="text-sm text-slate-500 leading-normal">This action cannot be undone. This record and all related data will be permanently removed.</p>
                    </div>
                </div>
                <div class="flex justify-end gap-3 mt-6">
                    <button type="button" onclick="document.getElementById('deleteClientModal').close()" class="px-4 py-2 text-sm font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 rounded-md transition-all">Cancel</button>
                    <form method="post" action="{{ path('app_clients_delete', {'slug': client.slug}) }}" class="inline m-0">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ client.id) }}">
                        <button type="submit" class="px-4 py-2 text-sm font-semibold text-white rounded-md shadow-sm transition-all border border-red-600" style="background-color: #dc2626;">Confirm Deletion</button>
                    </form>
                </div>
            </div>
        </div>
    </dialog>
    {% endif %}
{% endblock %}

{% block main_content %}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Info Card -->
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="p-6 md:p-8">
                    <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:2rem;">
                        <div style="display:flex;align-items:center;gap:1rem;">
                            {% if client.avatar %}
                                <img src="{{ asset('uploads/avatars/' ~ client.avatar) }}" class="flex-shrink-0 rounded-full object-cover border border-slate-200 shadow-sm" style="width:4rem;height:4rem;min-width:4rem;min-height:4rem;border-radius:9999px;" alt="Avatar">
                            {% else %}
                                <div style="flex-shrink:0;width:4rem;height:4rem;border-radius:50%;background:#f1f5f9;display:flex;align-items:center;justify-content:center;color:#475569;font-size:1.5rem;font-weight:700;border:1px solid #e2e8f0;line-height:1;">
                                    {{ client.name|slice(0, 2)|upper }}
                                </div>
                            {% endif %}
                            <div>
                                <h2 class="text-2xl font-bold text-slate-900 tracking-tight">{{ client.name }}</h2>
                                <p class="text-xs font-medium text-slate-500" style="margin-top:0.25rem;">{{ 'Client'|module_term }} Profile</p>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            <h3 class="text-sm font-medium text-slate-900 border-b border-slate-100" style="margin-bottom:1rem;padding-bottom:0.5rem;">Contact Information</h3>
                            <div class="space-y-4">
                                <div class="flex items-center gap-3">
                                    <i data-lucide="mail" class="w-4 h-4 text-slate-400"></i>
                                    <div>
                                        <div class="text-xs text-slate-500">Email</div>
                                        <div class="text-sm font-medium text-slate-900">{{ client.email ?? 'No email provided' }}</div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3">
                                    <i data-lucide="phone" class="w-4 h-4 text-slate-400"></i>
                                    <div>
                                        <div class="text-xs text-slate-500">Phone</div>
                                        <div class="text-sm font-medium text-slate-900">{{ client.phone ?? 'N/A' }}</div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3">
                                    <i data-lucide="globe" class="w-4 h-4 text-slate-400"></i>
                                    <div>
                                        <div class="text-xs text-slate-500">Website</div>
                                        <div class="text-sm font-medium text-slate-900">
                                            {% if client.website %}
                                                <a href="{{ client.website starts with 'http' ? client.website : 'https://' ~ client.website }}" target="_blank" class="text-blue-600 hover:underline">{{ client.website }}</a>
                                            {% else %}
                                                N/A
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div>
                            <h3 class="text-sm font-medium text-slate-900 border-b border-slate-100" style="margin-bottom:1rem;padding-bottom:0.5rem;">Mailing Address</h3>
                            <div class="flex items-start gap-3">
                                <i data-lucide="map-pin" class="flex-shrink-0 w-4 h-4 text-slate-400 mt-0.5"></i>
                                <div class="text-sm text-slate-700 leading-relaxed">
                                    {{ client.address ? client.address|nl2br : 'No address set' }}
                                </div>
                            </div>
                        </div>
                    </div>

                    {% if active_module == 'doctor' and patient_profile is not null %}
                        <div class="mt-8 pt-8 border-t border-slate-100">
                            <h3 class="text-sm font-semibold text-slate-900 uppercase tracking-wider mb-4">Medical File Summary</h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                                    <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Disease Category</div>
                                    <div class="text-sm font-semibold text-slate-800">{{ patient_profile.diseaseCategory|default('Unclassified') }}</div>
                                </div>
                                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                                    <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Chronic Illnesses</div>
                                    <div class="text-sm font-semibold text-slate-800">{{ patient_profile.chronicDiseases|default('None Declared') }}</div>
                                </div>
                            </div>
                            <div class="mt-4 p-4 rounded-xl bg-slate-50 border border-slate-100">
                                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">General Medical Notes</div>
                                <div class="text-sm text-slate-700 leading-relaxed whitespace-pre-line">{{ patient_profile.generalMedicalNotes|default('No history notes added.') }}</div>
                            </div>

                            <h3 class="text-sm font-semibold text-slate-900 uppercase tracking-wider mb-4 mt-6">Emergency Contact</h3>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                                    <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Name</div>
                                    <div class="text-sm font-semibold text-slate-800">{{ patient_profile.emergencyContactName|default('N/A') }}</div>
                                </div>
                                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                                    <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Relationship</div>
                                    <div class="text-sm font-semibold text-slate-800">{{ patient_profile.emergencyContactRelation|default('N/A') }}</div>
                                </div>
                                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                                    <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Phone Number</div>
                                    <div class="text-sm font-semibold text-slate-800">{{ patient_profile.emergencyContactPhone|default('N/A') }}</div>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
            <!-- Recent Transactions for this Client -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="p-6 md:p-8 border-b border-slate-100 flex items-center justify-between bg-slate-50/30">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 tracking-tight">Recent {{ 'Sales'|module_term }} History</h3>
                        <p class="text-sm text-slate-500">Last transactions with this {{ 'client'|module_term }}</p>
                    </div>
                    <a href="{{ path('app_sales_index', {'contact_id': client.slug}) }}" class="text-sm font-bold text-indigo-600 hover:text-indigo-700 transition-colors">View All</a>
                </div>
                
                <div class="divide-y divide-slate-100">
                    {% for sale in recent_sales %}
                        <a href="{{ path('app_sales_show', {'slug': sale.slug}) }}" class="flex items-center justify-between p-4 hover:bg-slate-50/50 transition-colors group">
                            <div class="flex items-center gap-3 min-w-0 flex-1">
                                <div class="w-10 h-10 rounded-lg bg-emerald-50 border border-emerald-100 text-emerald-600 flex items-center justify-center flex-shrink-0 shadow-sm">
                                    <i data-lucide="receipt" class="w-5 h-5"></i>
                                </div>
                                <div class="min-w-0">
                                    <div class="text-sm font-bold text-slate-900">{{ 'Sale'|module_term }} INV-{{ "%04d"|format(sale.id) }}</div>
                                    <div class="text-xs text-slate-500">{{ sale.createdAt|date('M d, Y') }}</div>
                                </div>
                            </div>
                            <div class="text-right flex flex-col items-end flex-shrink-0 ml-4" style="display: flex; flex-direction: column; align-items: flex-end; justify-content: center; text-align: right; flex-shrink: 0; margin-left: 16px;">
                                {% if active_module != 'doctor' %}
                                <div class="text-sm font-bold text-slate-900">${{ sale.total|number_format(2) }}</div>
                                {% endif %}
                                
                                {% set status = sale.paymentStatus|default('Unpaid') %}
                                {% set style_map = {
                                    'Paid': { 'text': '#059669', 'bg': '#10b981', 'light': '#ecfdf5' },
                                    'Partial': { 'text': '#d97706', 'bg': '#f59e0b', 'light': '#fef3c7' },
                                    'Unpaid': { 'text': '#e11d48', 'bg': '#f43f5e', 'light': '#fff1f2' },
                                    'Overpaid': { 'text': '#7c3aed', 'bg': '#8b5cf6', 'light': '#f5f3ff' },
                                    'Refunded': { 'text': '#475569', 'bg': '#64748b', 'light': '#f1f5f9' },
                                    'Cancelled': { 'text': '#e11d48', 'bg': '#f43f5e', 'light': '#fff1f2' }
                                } %}
                                {% set status_style = style_map[status] ?? { 'text': '#475569', 'bg': '#64748b', 'light': '#f1f5f9' } %}
                                
                                <div style="color: {{ status_style.text }}; background-color: {{ status_style.light }}; font-size: 10px; font-weight: bold; padding: 2px 6px; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.05em; display: inline-flex; align-items: center; gap: 4px; margin-top: 4px;">
                                    <span style="width: 4px; height: 4px; border-radius: 9999px; display: inline-block; background-color: {{ status_style.bg }};"></span>
                                    {{ status }}
                                </div>
                            </div>
                        </a>
                    {% else %}
                        <div class="flex flex-col items-center justify-center py-12 text-slate-400">
                            <div class="w-12 h-12 bg-slate-50 rounded-full flex items-center justify-center mb-4 border border-slate-100 shadow-sm">
                                <i data-lucide="history" class="w-5 h-5 text-slate-400"></i>
                            </div>
                            <p class="text-sm font-medium text-slate-900">No {{ 'sales'|module_term }} transactions</p>
                            <p class="text-xs text-slate-500 mt-1">Transactions will appear once a {{ 'sale'|module_term }} is registered</p>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {% if active_module != 'doctor' and is_granted('see.purchases') %}
            <!-- Recent Purchases History (as Vendor) -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mt-6">
                <div class="p-6 md:p-8 border-b border-slate-100 flex items-center justify-between bg-slate-50/30">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 tracking-tight">Recent {{ 'Purchases'|module_term }} History</h3>
                        <p class="text-sm text-slate-500">Last purchases from this contact (acting as {{ 'supplier'|module_term }})</p>
                    </div>
                    <a href="{{ path('app_purchases_index', {'contact_id': client.slug}) }}" class="text-sm font-bold text-indigo-600 hover:text-indigo-700 transition-colors">View All</a>
                </div>
                
                <div class="divide-y divide-slate-100">
                    {% for purchase in recent_purchases %}
                        <a href="{{ path('app_purchases_show', {'slug': purchase.slug}) }}" class="flex items-center justify-between p-4 hover:bg-slate-50/50 transition-colors group">
                            <div class="flex items-center gap-3 min-w-0 flex-1">
                                <div class="w-10 h-10 rounded-lg bg-rose-50 border border-rose-100 text-rose-600 flex items-center justify-center flex-shrink-0 shadow-sm">
                                    <i data-lucide="shopping-bag" class="w-5 h-5"></i>
                                </div>
                                <div class="min-w-0">
                                    <div class="text-sm font-bold text-slate-900">{{ 'Purchase'|module_term }} PUR-{{ "%04d"|format(purchase.id) }}</div>
                                    <div class="text-xs text-slate-500">{{ purchase.createdAt|date('M d, Y') }}</div>
                                </div>
                            </div>
                            <div class="text-right flex flex-col items-end flex-shrink-0 ml-4" style="display: flex; flex-direction: column; align-items: flex-end; justify-content: center; text-align: right; flex-shrink: 0; margin-left: 16px;">
                                {% if active_module != 'doctor' %}
                                <div class="text-sm font-bold text-slate-900">${{ purchase.total|number_format(2) }}</div>
                                {% endif %}
                                
                                {% set status = purchase.paymentStatus|default('Unpaid') %}
                                {% set style_map = {
                                    'Paid': { 'text': '#059669', 'bg': '#10b981', 'light': '#ecfdf5' },
                                    'Partial': { 'text': '#d97706', 'bg': '#f59e0b', 'light': '#fef3c7' },
                                    'Unpaid': { 'text': '#e11d48', 'bg': '#f43f5e', 'light': '#fff1f2' },
                                    'Overpaid': { 'text': '#7c3aed', 'bg': '#8b5cf6', 'light': '#f5f3ff' },
                                    'Refunded': { 'text': '#475569', 'bg': '#64748b', 'light': '#f1f5f9' },
                                    'Cancelled': { 'text': '#e11d48', 'bg': '#f43f5e', 'light': '#fff1f2' }
                                } %}
                                {% set status_style = style_map[status] ?? { 'text': '#475569', 'bg': '#64748b', 'light': '#f1f5f9' } %}
                                
                                <div style="color: {{ status_style.text }}; background-color: {{ status_style.light }}; font-size: 10px; font-weight: bold; padding: 2px 6px; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.05em; display: inline-flex; align-items: center; gap: 4px; margin-top: 4px;">
                                    <span style="width: 4px; height: 4px; border-radius: 9999px; display: inline-block; background-color: {{ status_style.bg }};"></span>
                                    {{ status }}
                                </div>
                            </div>
                        </a>
                    {% else %}
                        <div class="flex flex-col items-center justify-center py-12 text-slate-400">
                            <div class="w-12 h-12 bg-slate-50 rounded-full flex items-center justify-center mb-4 border border-slate-100 shadow-sm">
                                <i data-lucide="history" class="w-5 h-5 text-slate-400"></i>
                            </div>
                            <p class="text-sm font-medium text-slate-900">No {{ 'purchase'|module_term }} transactions</p>
                            <p class="text-xs text-slate-500 mt-1">Transactions will appear once a {{ 'purchase'|module_term }} is registered</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {% if active_module == 'doctor' %}
            <!-- Attached Documents / Medical Files -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mt-6">
                <div class="p-6 md:p-8 border-b border-slate-100 flex items-center justify-between bg-slate-50/30">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 tracking-tight">Attached Documents & Medical Files</h3>
                        <p class="text-sm text-slate-500">Scans, lab reports, and other patient attachments</p>
                    </div>
                    <button type="button" onclick="document.getElementById('uploadDocDialog').showModal()" class="inline-flex h-9 items-center justify-center gap-2 rounded-md bg-indigo-600 px-4 py-2 text-xs font-semibold text-white shadow hover:bg-indigo-700 transition-colors">
                        <i data-lucide="plus-circle" class="w-4 h-4"></i>
                        <span>Upload File</span>
                    </button>
                </div>
                
                <div class="divide-y divide-slate-100">
                    {% for doc in attached_documents %}
                        <div class="flex items-center justify-between p-4 hover:bg-slate-50/50 transition-colors group">
                            <div class="flex items-center gap-3 min-w-0 flex-1">
                                <div class="w-10 h-10 rounded-lg bg-indigo-50 border border-indigo-100 text-indigo-600 flex items-center justify-center flex-shrink-0 shadow-sm">
                                    <i data-lucide="file-text" class="w-5 h-5"></i>
                                </div>
                                <div class="min-w-0">
                                    <div class="text-sm font-bold text-slate-900">{{ doc.label }}</div>
                                    {% if doc.description %}
                                        <div class="text-xs text-slate-500 truncate max-w-md">{{ doc.description }}</div>
                                    {% endif %}
                                    <div class="text-[10px] text-slate-400 mt-1">Uploaded on {{ doc.createdAt|date('M d, Y') }} by {{ doc.uploadedBy ? doc.uploadedBy.username : 'Unknown' }}</div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 ml-4 flex-shrink-0">
                                <a href="{{ path('app_patient_document_download', {id: doc.id}) }}" class="p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all" title="Download">
                                    <i data-lucide="download" class="w-4.5 h-4.5"></i>
                                </a>
                                <button type="button" onclick="document.getElementById('deleteDocDialog_{{ doc.id }}').showModal()" class="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-all" title="Delete">
                                    <i data-lucide="trash-2" class="w-4.5 h-4.5"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Delete Document Dialog -->
                        <dialog id="deleteDocDialog_{{ doc.id }}" style="margin:auto;" class="p-0 rounded-lg shadow-xl border border-slate-200 backdrop:bg-slate-600/20 backdrop:backdrop-blur-[2px] overflow-hidden">
                            <div class="bg-white max-w-sm w-full p-6 text-left">
                                <h3 class="text-lg font-bold text-slate-900 mb-2">Delete Document?</h3>
                                <p class="text-sm text-slate-500 mb-6">Are you sure you want to permanently delete "{{ doc.label }}"?</p>
                                <div class="flex justify-end gap-3">
                                    <button type="button" onclick="document.getElementById('deleteDocDialog_{{ doc.id }}').close()" class="px-4 py-2 text-sm font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 rounded-md transition-all">Cancel</button>
                                    <form method="post" action="{{ path('app_patient_document_delete', {id: doc.id}) }}" class="inline m-0">
                                        <button type="submit" class="px-4 py-2 text-sm font-semibold text-white rounded-md shadow-sm transition-all border border-red-600" style="background-color: #dc2626;">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </dialog>
                    {% else %}
                        <div class="flex flex-col items-center justify-center py-12 text-slate-400">
                            <div class="w-12 h-12 bg-slate-50 rounded-full flex items-center justify-center mb-4 border border-slate-100 shadow-sm">
                                <i data-lucide="file-text" class="w-5 h-5 text-slate-400"></i>
                            </div>
                            <p class="text-sm font-medium text-slate-900">No attachments uploaded</p>
                            <p class="text-xs text-slate-500 mt-1">Upload records, prescription scans, or test outcomes</p>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Upload Document Dialog -->
            <dialog id="uploadDocDialog" style="margin:auto;" class="p-0 rounded-lg shadow-xl border border-slate-200 backdrop:bg-slate-600/20 backdrop:backdrop-blur-[2px] overflow-hidden">
                <div class="bg-white max-w-md w-full p-6 text-left">
                    <h3 class="text-lg font-bold text-slate-900 mb-4">Upload New Patient File</h3>
                    <form method="post" action="{{ path('app_patient_document_upload', {id: client.id}) }}" enctype="multipart/form-data" class="space-y-4">
                        <div>
                            <label class="block text-sm font-semibold text-slate-900 mb-1">Document Name / Label</label>
                            <input type="text" name="label" required placeholder="e.g. Blood Test Result, MRI Scan" class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 text-sm">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-slate-900 mb-1">Description (Optional)</label>
                            <textarea name="description" rows="2" placeholder="Summary notes on this document..." class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 text-sm"></textarea>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-slate-900 mb-1">Select File</label>
                            <input type="file" name="document" required class="w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700 file:cursor-pointer hover:file:bg-indigo-100">
                        </div>
                        <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
                            <button type="button" onclick="document.getElementById('uploadDocDialog').close()" class="px-4 py-2 text-sm font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 rounded-md transition-all">Cancel</button>
                            <button type="submit" class="px-4 py-2 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-md shadow-sm transition-colors">Upload</button>
                        </div>
                    </form>
                </div>
            </dialog>
            {% endif %}

            {# General Notes Section #}
            {{ include('components/_notes_section.html.twig', {
                'targetType': 'contact',
                'targetId': client.id,
                'notes': get_notes('contact', client.id),
                'redirectUrl': path('app_clients_show', {'slug': client.slug})
            }) }}
        </div>
        
        <!-- Sidebar Actions/Stats -->
        <div class="space-y-6">
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
                <h3 class="text-sm font-semibold text-slate-900 mb-4">Intelligence Briefing</h3>
                <div class="space-y-4">
                    {% if active_module != 'doctor' %}
                    <div>
                        <div class="text-xs font-medium text-slate-500 mb-1">Lifetime {{ 'Revenue'|module_term }}</div>
                        <div class="text-3xl font-bold tracking-tight text-slate-900">${{ lifetime_revenue|number_format(2) }}</div>
                    </div>
                    <div class="pt-4 border-t border-slate-100">
                        <div class="flex items-center justify-between">
                            <div>
                                <div class="text-xs font-medium text-slate-500 mb-1">Total {{ 'Sales'|module_term }} Orders</div>
                                <div class="text-xl font-bold text-slate-900">{{ total_orders }}</div>
                            </div>
                            <div class="w-10 h-10 bg-slate-50 rounded-md border border-slate-100 flex items-center justify-center">
                                <i data-lucide="bar-chart-3" class="w-5 h-5 text-slate-400"></i>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                    {% if active_module != 'doctor' and lifetime_spending > 0 %}
                    <div class="pt-4 border-t border-slate-100">
                        <div>
                            <div class="text-xs font-medium text-slate-500 mb-1">Lifetime Spending (as Vendor)</div>
                            <div class="text-2xl font-bold tracking-tight text-slate-900">${{ lifetime_spending|number_format(2) }}</div>
                        </div>
                    </div>
                    <div class="pt-4 border-t border-slate-100">
                        <div class="flex items-center justify-between">
                            <div>
                                <div class="text-xs font-medium text-slate-500 mb-1">Total {{ 'Purchase'|module_term }} Orders</div>
                                <div class="text-xl font-bold text-slate-900">{{ total_purchases }}</div>
                            </div>
                            <div class="w-10 h-10 bg-slate-50 rounded-md border border-slate-100 flex items-center justify-center">
                                <i data-lucide="shopping-cart" class="w-5 h-5 text-slate-400"></i>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>

            {% if active_module == 'doctor' %}
            <!-- Current Active Prescriptions Card -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 mt-6">
                <h3 class="text-sm font-semibold text-slate-900 mb-4 flex items-center gap-2">
                    <i data-lucide="pill" class="w-4 h-4 text-indigo-500"></i>
                    <span>Currently Prescribed</span>
                </h3>
                <div class="space-y-4">
                    {% for pi in active_prescriptions %}
                        <div class="p-3 rounded-lg bg-slate-50 border border-slate-100">
                            <div class="text-sm font-bold text-slate-800">{{ pi.medicationName }}</div>
                            <div class="text-xs text-slate-500 mt-1 flex flex-wrap gap-x-2 gap-y-1">
                                <span><strong>Dosage:</strong> {{ pi.dosage|default('N/A') }}</span>
                                <span>•</span>
                                <span><strong>Freq:</strong> {{ pi.frequency|default('N/A') }}</span>
                                <span>•</span>
                                <span><strong>Dur:</strong> {{ pi.duration|default('N/A') }}</span>
                            </div>
                            {% if pi.instructions %}
                                <div class="text-[11px] text-slate-400 mt-1 italic">"{{ pi.instructions }}"</div>
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="text-center py-6 text-slate-400 text-xs">
                            No active prescriptions found.
                        </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Upcoming Appointments Card -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 mt-6">
                <h3 class="text-sm font-semibold text-slate-900 mb-4 flex items-center gap-2">
                    <i data-lucide="calendar" class="w-4 h-4 text-indigo-500"></i>
                    <span>Upcoming Appointments</span>
                </h3>
                <div class="space-y-4">
                    {% for apt in upcoming_appointments %}
                        <div class="p-3 rounded-lg bg-slate-50 border border-slate-100 flex items-start gap-3">
                            <div class="w-8 h-8 rounded-lg bg-indigo-50 border border-indigo-100 text-indigo-600 flex items-center justify-center flex-shrink-0">
                                <i data-lucide="clock" class="w-4 h-4"></i>
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="text-xs font-bold text-slate-800">{{ apt.startAt|date('M d, Y @ H:i') }}</div>
                                {% if apt.reason %}
                                    <div class="text-[11px] text-slate-500 truncate">{{ apt.reason }}</div>
                                {% endif %}
                                <div class="text-[10px] text-slate-400 mt-1 flex items-center gap-1">
                                    <span class="w-1.5 h-1.5 rounded-full" style="background-color: {% if apt.status == 'confirmed' %}#10b981{% elseif apt.status == 'cancelled' %}#ef4444{% else %}#6366f1{% endif %};"></span>
                                    <span class="capitalize">{{ apt.status }}</span>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="text-center py-6 text-slate-400 text-xs">
                            No upcoming appointments.
                        </div>
                    {% endfor %}
                    <a href="{{ path('app_appointments_index') }}" class="block text-center text-xs font-bold text-indigo-600 hover:text-indigo-700 transition-colors pt-2 border-t border-slate-100">Go to Calendar</a>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
