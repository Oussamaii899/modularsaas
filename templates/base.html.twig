<!DOCTYPE html>
<html class="{{ setting('theme', 'light') }}">
    <head>
        <script>
            (function() {
                const cachedTheme = localStorage.getItem('theme');
                const dbTheme = '{{ setting('theme', 'light') }}';
                const theme = cachedTheme || dbTheme;
                if (theme === 'dark') {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
                if (!cachedTheme) {
                    localStorage.setItem('theme', dbTheme);
                }
            })();
        </script>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        
        {% block stylesheets %}
            {% block importmap %}{{ importmap('app') }} {% endblock %}
        {% endblock %}

        <style>
            :root {
                {% if setting('primary_color', 'indigo') == 'indigo' %}
                    --primary-50: #f5f3ff;
                    --primary-100: #ede9fe;
                    --primary-200: #ddd6fe;
                    --primary-300: #c084fc;
                    --primary-400: #a78bfa;
                    --primary-500: #8b5cf6;
                    --primary-600: #6366f1;
                    --primary-700: #4f46e5;
                    --primary-800: #3730a3;
                    --primary-900: #312e81;
                    --primary-950: #1e1b4b;
                {% elseif setting('primary_color', 'indigo') == 'emerald' %}
                    --primary-50: #ecfdf5;
                    --primary-100: #d1fae5;
                    --primary-200: #a7f3d0;
                    --primary-300: #6ee7b7;
                    --primary-400: #34d399;
                    --primary-500: #10b981;
                    --primary-600: #059669;
                    --primary-700: #047857;
                    --primary-800: #065f46;
                    --primary-900: #064e3b;
                    --primary-950: #022c22;
                {% elseif setting('primary_color', 'indigo') == 'blue' %}
                    --primary-50: #eff6ff;
                    --primary-100: #dbeafe;
                    --primary-200: #bfdbfe;
                    --primary-300: #93c5fd;
                    --primary-400: #60a5fa;
                    --primary-500: #3b82f6;
                    --primary-600: #2563eb;
                    --primary-700: #1d4ed8;
                    --primary-800: #1e40af;
                    --primary-900: #1e3a8a;
                    --primary-950: #172554;
                {% elseif setting('primary_color', 'indigo') == 'rose' %}
                    --primary-50: #fff1f2;
                    --primary-100: #ffe4e6;
                    --primary-200: #fecdd3;
                    --primary-300: #fda4af;
                    --primary-400: #fb7185;
                    --primary-500: #f43f5e;
                    --primary-600: #e11d48;
                    --primary-700: #be123c;
                    --primary-800: #9f1239;
                    --primary-900: #881337;
                    --primary-950: #4c0519;
                {% elseif setting('primary_color', 'indigo') == 'violet' %}
                    --primary-50: #fdf4ff;
                    --primary-100: #fae8ff;
                    --primary-200: #f5d0fe;
                    --primary-300: #f0abfc;
                    --primary-400: #e879f9;
                    --primary-500: #d946ef;
                    --primary-600: #8b5cf6;
                    --primary-700: #7c3aed;
                    --primary-800: #6d28d9;
                    --primary-900: #5b21b6;
                    --primary-950: #2e1065;
                {% endif %}
            }
        </style>

        {% block javascripts %}
            <script src="https://unpkg.com/lucide@latest" defer></script>
            <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.default.min.css" rel="stylesheet">
            <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
        {% endblock %}

        {# TomSelect dark mode overrides — must come AFTER the TomSelect CDN CSS to win the cascade #}
        <style id="tomselect-dark-overrides">
            /* ── Light Mode (default) ── */
            .ts-wrapper .ts-control,
            .ts-wrapper.single .ts-control {
                background-color: #f8fafc !important;
                border: 1px solid #cbd5e1 !important;
                border-radius: 0.5rem !important;
                padding: 0.625rem 1rem !important;
                font-size: 0.875rem !important;
                font-weight: 500 !important;
                color: #0f172a !important;
                box-shadow: none !important;
                transition: all 0.2s ease-in-out !important;
                display: flex !important;
                align-items: center !important;
            }
            .ts-wrapper.single.focus .ts-control,
            .ts-wrapper.focus .ts-control {
                border-color: var(--primary-500, #6366f1) !important;
                box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15) !important;
            }
            .ts-dropdown {
                background-color: #ffffff !important;
                border-radius: 0.5rem !important;
                border: 1px solid #e2e8f0 !important;
                box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05) !important;
                padding: 0.25rem 0 !important;
                font-size: 0.875rem !important;
                z-index: 50 !important;
            }
            .ts-dropdown .option {
                padding: 0.5rem 1rem !important;
                color: #334155 !important;
            }
            .ts-dropdown .option.active,
            .ts-dropdown .option:hover {
                background-color: rgba(99, 102, 241, 0.08) !important;
                color: var(--primary-700, #4f46e5) !important;
            }

            /* ── Dark Mode ── */
            html.dark .ts-wrapper .ts-control,
            html.dark .ts-wrapper.single .ts-control {
                background-color: #0f172a !important;
                background: #0f172a !important;
                color: #e2e8f0 !important;
                border-color: #334155 !important;
            }
            html.dark .ts-control input,
            html.dark .ts-control .item {
                background-color: transparent !important;
                background: transparent !important;
                color: #e2e8f0 !important;
            }
            html.dark .ts-wrapper.focus .ts-control,
            html.dark .ts-wrapper.single.focus .ts-control {
                border-color: var(--primary-500, #6366f1) !important;
                box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25) !important;
            }
            html.dark .ts-dropdown {
                background-color: #1e293b !important;
                color: #e2e8f0 !important;
                border-color: #334155 !important;
            }
            html.dark .ts-dropdown .option {
                color: #cbd5e1 !important;
            }
            html.dark .ts-dropdown .option:hover,
            html.dark .ts-dropdown .option.active {
                background-color: rgba(99, 102, 241, 0.18) !important;
                color: #ffffff !important;
            }
            html.dark .ts-wrapper.single .ts-control::after {
                border-color: #94a3b8 transparent transparent transparent !important;
            }
            html.dark .ts-wrapper.single.input-active .ts-control::after {
                border-color: transparent transparent #94a3b8 transparent !important;
            }
            /* Smaller sizing inside item rows */
            .item-row .ts-wrapper .ts-control {
                padding: 0.5rem 0.75rem !important;
                font-size: 0.875rem !important;
            }
        </style>

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="bg-slate-50 dark:bg-slate-900 font-['Inter'] text-slate-900 dark:text-slate-100 antialiased min-h-screen">
        {% block body %}{% endblock %}

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const searchInputs = document.querySelectorAll('input[name="q"]');
                
                searchInputs.forEach(input => {
                    let timeout = null;
                    input.addEventListener('input', (e) => {
                        clearTimeout(timeout);
                        const query = e.target.value;
                        const form = e.target.closest('form');
                        const url = new URL(form.action || window.location.href);
                        
                        timeout = setTimeout(() => {
                            url.searchParams.set('q', query);
                            
                            // Prevent full page reload on form submit if Enter is pressed
                            form.onsubmit = (event) => {
                                event.preventDefault();
                                return false;
                            };

                            fetch(url, {
                                headers: { 'X-Requested-With': 'XMLHttpRequest' }
                            })
                            .then(response => response.text())
                            .then(html => {
                                const parser = new DOMParser();
                                const doc = parser.parseFromString(html, 'text/html');
                                
                                // Replace Table
                                const oldTable = document.querySelector('table');
                                const newTable = doc.querySelector('table');
                                if (oldTable && newTable) {
                                    oldTable.innerHTML = newTable.innerHTML;
                                }

                                // Replace Pagination
                                const oldPagination = document.querySelector('.pagination-container');
                                const newPagination = doc.querySelector('.pagination-container');
                                if (oldPagination && newPagination) {
                                    oldPagination.innerHTML = newPagination.innerHTML;
                                }

                                // Update URL without reload
                                window.history.replaceState({}, '', url);

                                // Re-initialize icons
                                if (typeof lucide !== 'undefined') {
                                    lucide.createIcons();
                                }
                            })
                            .catch(err => console.error('Search failed:', err));
                        }, 300);
                    });
                });
            });
        </script>
    </body>
</html>
