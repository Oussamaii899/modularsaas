{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Suppliers | {{ company_name ?? 'ModularSaaS' }}{% endblock %}

{% block content_title %}Suppliers{% endblock %}
{% block content_subtitle %}Manage your vendor relationships{% endblock %}

{% block content_actions %}
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center w-full sm:w-auto gap-2 sm:gap-3">
        <!-- Search Bar -->
        <form action="{{ path('app_suppliers_index') }}" method="get" class="relative flex-1 sm:flex-none">
            <div class="absolute inset-y-0 pl-3.5 flex items-center pointer-events-none">
                <i data-lucide="search" class="w-4 h-4 text-slate-400" style="margin-left: 10px;"></i>
            </div>
            <input type="text" name="q" value="{{ searchQuery|default('') }}" placeholder="Search suppliers..." class="block w-full sm:w-[400px] h-10 pl-10 pr-4 py-2 text-sm bg-white border border-slate-200 rounded-lg placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all shadow-sm">
        </form>

        {% if is_granted('add.suppliers') %}
        <a href="{{ path('app_suppliers_new') }}" class="inline-flex h-10 items-center justify-center gap-2 rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow hover:bg-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 transition-colors">
            <i data-lucide="truck" class="w-4 h-4"></i>
            <span>Add Supplier</span>
        </a>
        {% endif %}
    </div>
{% endblock %}

{% block main_content %}
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50/30 transition-colors pointer-events-none">
                        <th class="h-12 px-4 align-middle font-medium text-slate-500 text-left uppercase tracking-wider text-[11px]">Supplier Info</th>
                        <th class="h-12 px-4 align-middle font-medium text-slate-500 text-center uppercase tracking-wider text-[11px]">Contact</th>
                        <th class="h-12 px-4 align-middle font-medium text-slate-500 text-center uppercase tracking-wider text-[11px]">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for supplier in suppliers %}
                        <tr class="hover:bg-slate-50/80 transition-colors group">
                            <td class="p-4 align-top">
                                <div class="flex items-start gap-3">
                                    <div class="w-10 h-10 rounded-full overflow-hidden flex-shrink-0 flex items-center justify-center bg-indigo-50 text-indigo-600 font-bold border border-indigo-100 shadow-sm">
                                        {% if supplier.avatar %}
                                            <img src="{{ asset('uploads/avatars/' ~ supplier.avatar) }}" class="w-full h-full object-cover" alt="{{ supplier.name }}">
                                        {% else %}
                                            {{ supplier.name|slice(0, 2)|upper }}
                                        {% endif %}
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="font-bold text-slate-900 text-base">{{ supplier.name }}</span>
                                        <a href="{{ supplier.website ? (supplier.website starts with 'http' ? supplier.website : 'https://' ~ supplier.website) : '#' }}" target="_blank" class="text-xs text-indigo-500 hover:text-indigo-700 hover:underline transition-colors truncate max-w-[180px] mt-0.5">
                                            {{ supplier.website|default('No website') }}
                                        </a>
                                    </div>
                                </div>
                            </td>
                            <td class="p-4 align-top text-center">
                                <div class="inline-flex flex-col gap-2.5 text-left">
                                    <div class="flex items-center gap-2 text-slate-500 text-xs px-1 py-0.5">
                                        <i data-lucide="mail" class="w-3.5 h-3.5 text-slate-400"></i>
                                        <span class="text-slate-600">{{ supplier.email ?? 'No email' }}</span>
                                    </div>
                                    <div class="flex items-center gap-2 text-slate-500 text-xs px-1 py-0.5">
                                        <i data-lucide="phone" class="w-3.5 h-3.5 text-slate-400"></i>
                                        <span class="text-slate-600">{{ supplier.phone ?? 'N/A' }}</span>
                                    </div>
                                </div>
                            </td>
                            <td class="p-4 align-top text-center">
                                <div class="flex items-center justify-center gap-1">
                                    <a href="{{ path('app_suppliers_show', {'slug': supplier.slug}) }}" class="p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all" title="View Details">
                                        <i data-lucide="eye" class="w-4.5 h-4.5"></i>
                                    </a>
                                    {% if is_granted('edit.suppliers') %}
                                    <a href="{{ path('app_suppliers_edit', {'slug': supplier.slug}) }}" class="p-2 text-slate-400 hover:text-amber-600 hover:bg-amber-50 rounded-lg transition-all" title="Edit">
                                        <i data-lucide="pencil" class="w-4.5 h-4.5"></i>
                                    </a>
                                    {% endif %}
                                    {% if is_granted('delete.suppliers') %}
                                    <button type="button" onclick="document.getElementById('deleteModal_{{ supplier.id }}').showModal()" class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all" title="Delete">
                                        <i data-lucide="trash-2" class="w-4.5 h-4.5"></i>
                                    </button>

                                    <!-- Iterative Delete Modal -->
                                    <dialog id="deleteModal_{{ supplier.id }}" style="margin:auto;" class="m-auto p-0 rounded-lg shadow-xl border border-slate-200 backdrop:bg-slate-600/20 backdrop:backdrop-blur-[2px] open:animate-in open:fade-in open:zoom-in-95 duration-200 overflow-hidden">
                                        <div class="bg-white max-w-md w-full text-left">
                                            <div class="p-6">
                                                <div class="flex items-start gap-4 mb-5">
                                                    <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
                                                        <i data-lucide="alert-circle" class="w-5 h-5 text-red-600"></i>
                                                    </div>
                                                    <div class="flex-1">
                                                        <h3 class="text-lg font-bold text-slate-900 leading-none mb-2">Delete {{ supplier.name }}?</h3>
                                                        <p class="text-sm text-slate-500 leading-normal">This action cannot be undone. This record will be permanently removed.</p>
                                                    </div>
                                                </div>
                                                <div class="flex justify-end gap-3 mt-6">
                                                    <button type="button" onclick="document.getElementById('deleteModal_{{ supplier.id }}').close()" class="px-4 py-2 text-sm font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 rounded-md transition-all">Cancel</button>
                                                    <form method="post" action="{{ path('app_suppliers_delete', {'slug': supplier.slug}) }}" class="inline m-0">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ supplier.id) }}">
                                                        <button type="submit" class="px-4 py-2 text-sm font-bold text-white rounded-md shadow-sm transition-all border border-red-600" style="background-color: #dc2626;">Delete Supplier</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </dialog>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="p-8 text-center text-slate-500">
                                <div class="flex flex-col items-center gap-3">
                                    <i data-lucide="truck" class="w-8 h-8 text-slate-300"></i>
                                    <div class="flex flex-col gap-1">
                                        <p class="font-medium text-slate-900">No suppliers found</p>
                                        <p class="text-sm">Try adjusting your search or add a new vendor</p>
                                    </div>
                                    {% if is_granted('add.suppliers') %}
                                    <a href="{{ path('app_suppliers_new') }}" class="mt-2 inline-flex h-10 items-center justify-center gap-2 rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow hover:bg-indigo-700 transition-colors">
                                        <i data-lucide="plus" class="w-4 h-4"></i>
                                        Add First Supplier
                                    </a>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% include 'components/_pagination.html.twig' with {
            items: suppliers,
            pagesCount: pagesCount,
            currentPage: currentPage,
            totalItems: totalItems
        } %}
    </div>
{% endblock %}
