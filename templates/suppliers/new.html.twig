    {% extends 'layouts/dashboard.html.twig' %}

{% block title %}Add {{ 'Supplier'|module_term }} | {{ company_name ?? 'ModularSaaS' }}{% endblock %}

{% block content_title %}Add New {{ 'Supplier'|module_term }}{% endblock %}
{% block content_subtitle %}Onboard a new {{ 'supplier'|module_term }}{% endblock %}

{% block content_actions %}
    <a href="{{ path('app_suppliers_index') }}" class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 rounded-md shadow-sm transition-colors">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        <span>Back to List</span>
    </a>
{% endblock %}

{% block main_content %}
    <div class="max-w-3xl mx-auto pb-12">
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="p-6 md:p-8">
                <div class="mb-8">
                    <h3 class="text-lg font-bold text-slate-900">{{ 'Supplier Information'|module_term }}</h3>
                    <p class="text-sm text-slate-500 mt-1">Please ensure {{ 'supplier'|module_term }} identities remain accurate for logistics.</p>
                </div>

                {{ form_start(form, {'attr': {'class': 'space-y-6', 'enctype': 'multipart/form-data'}}) }}
                    <div class="flex flex-col md:flex-row gap-8 items-center md:items-start mb-6 pb-6 border-b border-slate-100">
                        <div class="flex flex-col items-center gap-3">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Profile Avatar</label>
                            <label for="{{ form.avatarFile.vars.id }}" class="relative group rounded-full overflow-hidden border-2 border-slate-200 hover:border-indigo-500 bg-slate-50 flex items-center justify-center cursor-pointer transition-all shadow-inner" style="width:5rem;height:5rem;min-width:5rem;min-height:5rem;">
                                <div id="avatar-placeholder" class="text-xl font-bold text-slate-400 select-none">
                                    SU
                                </div>
                                <img id="avatar-preview" src="" class="w-full h-full object-cover hidden transition-transform group-hover:scale-105" alt="Avatar">
                                <div class="absolute inset-0 bg-slate-900/40 opacity-0 group-hover:opacity-100 flex flex-col items-center justify-center text-white transition-opacity duration-200">
                                    <i data-lucide="camera" class="w-5 h-5 mb-1"></i>
                                    <span class="text-[9px] font-medium uppercase tracking-wider">Upload</span>
                                </div>
                            </label>
                            {{ form_widget(form.avatarFile, {'attr': {'class': 'sr-only', 'onchange': 'previewAvatar(this)'}}) }}
                            <button id="clear-avatar-button" type="button" onclick="clearAvatarSelection()" class="hidden" style="border:0;border-radius:0.5rem;background:#fee2e2;color:#b91c1c;padding:0.45rem 0.75rem;font-size:0.75rem;font-weight:700;cursor:pointer;">
                                Clear avatar
                            </button>
                            <p class="text-[10px] text-slate-400">JPG, PNG, WebP up to 2MB</p>
                            <div class="text-rose-500 text-xs font-medium mt-1">{{ form_errors(form.avatarFile) }}</div>
                        </div>

                        <div class="flex-1 w-full space-y-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div class="space-y-3">
                                    <label class="text-sm font-semibold text-slate-900">{{ 'Supplier'|module_term }} Name</label>
                                    {{ form_widget(form.name, {'attr': {'class': 'w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-4 focus:ring-slate-900/10 focus:border-slate-900 transition-all text-sm font-medium text-slate-900 placeholder-slate-400', 'placeholder': 'e.g. Global Tech Solutions'}}) }}
                                    {{ form_errors(form.name) }}
                                </div>
                                <div class="space-y-3">
                                    <label class="text-sm font-semibold text-slate-900">Contact Phone</label>
                                    {{ form_widget(form.phone, {'attr': {'class': 'w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-4 focus:ring-slate-900/10 focus:border-slate-900 transition-all text-sm font-medium text-slate-900 placeholder-slate-400', 'placeholder': '+1 (555) 000-0000'}}) }}
                                    {{ form_errors(form.phone) }}
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div class="space-y-3">
                                    <label class="text-sm font-semibold text-slate-900">Official Email</label>
                                    {{ form_widget(form.email, {'attr': {'class': 'w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-4 focus:ring-slate-900/10 focus:border-slate-900 transition-all text-sm font-medium text-slate-900 placeholder-slate-400', 'placeholder': 'contact@supplier.com'}}) }}
                                    {{ form_errors(form.email) }}
                                </div>
                                <div class="space-y-3">
                                    <label class="text-sm font-semibold text-slate-900">Company Website</label>
                                    {{ form_widget(form.website, {'attr': {'class': 'w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-4 focus:ring-slate-900/10 focus:border-slate-900 transition-all text-sm font-medium text-slate-900 placeholder-slate-400', 'placeholder': 'https://supplier.com'}}) }}
                                    {{ form_errors(form.website) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-3">
                        <label class="text-sm font-semibold text-slate-900">Business Address</label>
                        {{ form_widget(form.address, {'attr': {'class': 'w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-4 focus:ring-slate-900/10 focus:border-slate-900 transition-all text-sm font-medium text-slate-900 placeholder-slate-400', 'rows': '3', 'placeholder': 'HQ Address...'}}) }}
                        {{ form_errors(form.address) }}
                    </div>

                    <div class="pt-8 flex items-center justify-end">
                        <a href="{{ path('app_suppliers_index') }}" class="inline-block px-14 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-100 rounded-lg transition-colors" style="margin-right: 40px;padding:10px;">Discard</a>
                        <button type="submit" class="inline-flex items-center gap-2 px-20 py-2.5 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm transition-colors active:scale-95" style="padding:10px;">
                            <span>Register {{ 'Supplier'|module_term }}</span>
                            <i data-lucide="arrow-right" class="w-4 h-4 text-white"></i>
                        </button>
                    </div>
                {{ form_end(form) }}

                <script>
                    function previewAvatar(input) {
                        if (input.files && input.files[0]) {
                            const reader = new FileReader();
                            reader.onload = function(e) {
                                const preview = document.getElementById('avatar-preview');
                                const placeholder = document.getElementById('avatar-placeholder');
                                
                                preview.src = e.target.result;
                                preview.classList.remove('hidden');
                                if (placeholder) {
                                    placeholder.classList.add('hidden');
                                }
                                document.getElementById('clear-avatar-button')?.classList.remove('hidden');
                            }
                            reader.readAsDataURL(input.files[0]);
                        }
                    }

                    function clearAvatarSelection() {
                        const input = document.getElementById('{{ form.avatarFile.vars.id }}');
                        const preview = document.getElementById('avatar-preview');
                        const placeholder = document.getElementById('avatar-placeholder');
                        const clearButton = document.getElementById('clear-avatar-button');

                        if (input) {
                            input.value = '';
                        }
                        if (preview) {
                            preview.src = '';
                            preview.classList.add('hidden');
                        }
                        placeholder?.classList.remove('hidden');
                        clearButton?.classList.add('hidden');
                    }
                </script>
            </div>
        </div>
    </div>
{% endblock %}
