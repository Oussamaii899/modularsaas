{% set pagesCount = pagesCount|default(0) %}
{% set currentPage = currentPage|default(1) %}
{% set totalItems = totalItems|default(0) %}
{% set items = items|default([]) %}

{% if totalItems > 0 %}
    <div class="pagination-container px-4 sm:px-6 py-4 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-50/30">
        <div class="text-xs font-bold text-slate-500 uppercase tracking-widest">
            Showing {{ items|length }} of {{ totalItems }} records
        </div>

        {% if pagesCount > 1 %}
            <div class="flex items-center gap-2">
                {% if currentPage > 1 %}
                    <a href="{{ path(app.request.get('_route'), app.request.query.all|merge({'page': currentPage - 1})) }}" class="p-2 text-slate-400 hover:text-indigo-600 hover:bg-white rounded-lg border border-transparent hover:border-slate-200 transition-all shadow-sm">
                        <i data-lucide="chevron-left" class="w-4 h-4"></i>
                    </a>
                {% else %}
                    <div class="p-2 text-slate-200 cursor-not-allowed">
                        <i data-lucide="chevron-left" class="w-4 h-4"></i>
                    </div>
                {% endif %}

                <div class="flex items-center gap-1">
                    {% if pagesCount <= 5 %}
                        {% for i in 1..pagesCount %}
                            {% if i == currentPage %}
                                <span class="w-8 h-8 flex items-center justify-center text-xs font-black bg-indigo-600 text-white rounded-lg shadow-lg shadow-indigo-100">{{ i }}</span>
                            {% else %}
                                <a href="{{ path(app.request.get('_route'), app.request.query.all|merge({'page': i})) }}" class="w-8 h-8 flex items-center justify-center text-xs font-bold text-slate-500 hover:text-indigo-600 hover:bg-white rounded-lg border border-transparent hover:border-slate-200 transition-all">{{ i }}</a>
                            {% endif %}
                        {% endfor %}
                    {% else %}
                        {# Always show page 1 #}
                        {% if currentPage == 1 %}
                            <span class="w-8 h-8 flex items-center justify-center text-xs font-black bg-indigo-600 text-white rounded-lg shadow-lg shadow-indigo-100">1</span>
                        {% else %}
                            <a href="{{ path(app.request.get('_route'), app.request.query.all|merge({'page': 1})) }}" class="w-8 h-8 flex items-center justify-center text-xs font-bold text-slate-500 hover:text-indigo-600 hover:bg-white rounded-lg border border-transparent hover:border-slate-200 transition-all">1</a>
                        {% endif %}

                        {# Left Ellipsis #}
                        {% if currentPage > 3 %}
                            <span class="w-8 h-8 flex items-center justify-center text-xs font-bold text-slate-400">...</span>
                        {% endif %}

                        {# Middle range (around currentPage) #}
                        {% set startPage = max(2, currentPage - 1) %}
                        {% set endPage = min(pagesCount - 1, currentPage + 1) %}
                        
                        {# Adjust middle range bounds for edge cases #}
                        {% if currentPage <= 3 %}
                            {% set startPage = 2 %}
                            {% set endPage = 3 %}
                        {% elseif currentPage >= pagesCount - 2 %}
                            {% set startPage = pagesCount - 2 %}
                            {% set endPage = pagesCount - 1 %}
                        {% endif %}

                        {% for i in startPage..endPage %}
                            {% if i == currentPage %}
                                <span class="w-8 h-8 flex items-center justify-center text-xs font-black bg-indigo-600 text-white rounded-lg shadow-lg shadow-indigo-100">{{ i }}</span>
                            {% else %}
                                <a href="{{ path(app.request.get('_route'), app.request.query.all|merge({'page': i})) }}" class="w-8 h-8 flex items-center justify-center text-xs font-bold text-slate-500 hover:text-indigo-600 hover:bg-white rounded-lg border border-transparent hover:border-slate-200 transition-all">{{ i }}</a>
                            {% endif %}
                        {% endfor %}

                        {# Right Ellipsis #}
                        {% if currentPage < pagesCount - 2 %}
                            <span class="w-8 h-8 flex items-center justify-center text-xs font-bold text-slate-400">...</span>
                        {% endif %}

                        {# Always show last page #}
                        {% if currentPage == pagesCount %}
                            <span class="w-8 h-8 flex items-center justify-center text-xs font-black bg-indigo-600 text-white rounded-lg shadow-lg shadow-indigo-100">{{ pagesCount }}</span>
                        {% else %}
                            <a href="{{ path(app.request.get('_route'), app.request.query.all|merge({'page': pagesCount})) }}" class="w-8 h-8 flex items-center justify-center text-xs font-bold text-slate-500 hover:text-indigo-600 hover:bg-white rounded-lg border border-transparent hover:border-slate-200 transition-all">{{ pagesCount }}</a>
                        {% endif %}
                    {% endif %}
                </div>

                {% if currentPage < pagesCount %}
                    <a href="{{ path(app.request.get('_route'), app.request.query.all|merge({'page': currentPage + 1})) }}" class="p-2 text-slate-400 hover:text-indigo-600 hover:bg-white rounded-lg border border-transparent hover:border-slate-200 transition-all shadow-sm">
                        <i data-lucide="chevron-right" class="w-4 h-4"></i>
                    </a>
                {% else %}
                    <div class="p-2 text-slate-200 cursor-not-allowed">
                        <i data-lucide="chevron-right" class="w-4 h-4"></i>
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endif %}
