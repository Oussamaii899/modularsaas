{% set is_sale = (type == 'sale') %}
{% set prefix = is_sale ? 'INV' : 'PUR' %}
{% set icon = is_sale ? 'receipt' : 'shopping-bag' %}
{% set icon_color = is_sale ? 'emerald' : 'rose' %}
{# Status logic moved inside the loop to be item-specific #}
{% set sign = is_sale ? '+' : '' %}

<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden group/table">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[600px]">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-200">
                    <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Transaction</th>
                    <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Contact</th>
                    <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Amount</th>
                    <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                {% for item in items %}
                    <tr class="hover:bg-slate-50/50 transition-colors group">
                        <td class="px-6 py-5">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center text-slate-400 group-hover:bg-{{ icon_color }}-50 group-hover:text-{{ icon_color }}-600 transition-all duration-300 shadow-sm border border-slate-100 flex-shrink-0">
                                    <i data-lucide="{{ icon }}" class="w-5 h-5"></i>
                                </div>
                                <div>
                                    <div class="text-sm font-bold text-slate-900 uppercase tracking-tight">{{ prefix }}-{{ "%04d"|format(item.id) }}</div>
                                    <div class="text-[11px] font-medium text-slate-500 mt-1">{{ item.createdAt ? item.createdAt|date('M d, Y H:i') : '' }}</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-5">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-indigo-50 flex items-center justify-center text-xs font-bold text-indigo-600 border border-indigo-100 shadow-sm transition-transform group-hover:scale-110 flex-shrink-0">
                                    {{ item.contact.name|first|upper }}
                                </div>
                                <div class="text-sm font-semibold text-slate-700 tracking-tight">{{ item.contact.name }}</div>
                            </div>
                        </td>
                        <td class="px-6 py-5">
                            <div class="text-sm font-bold {{ is_sale ? 'text-emerald-600' : 'text-slate-900' }} tracking-tight leading-none mb-2">{{ sign }}${{ item.total|number_format(2) }}</div>
                            
                            {% set status = item.paymentStatus|default('Unpaid') %}
                            {% set color_map = {
                                'Paid': 'emerald',
                                'Partial': 'amber',
                                'Unpaid': 'rose',
                                'Overpaid': 'purple',
                                'Refunded': 'slate',
                                'Cancelled': 'rose'
                            } %}
                            {% set color = color_map[status] ?? 'slate' %}
                            
                            <div class="text-[10px] font-bold text-{{ color }}-700 bg-{{ color }}-50 border-{{ color }}-200 px-2.5 py-1 rounded-md inline-flex items-center gap-1.5 border shadow-sm uppercase tracking-wider">
                                <span class="w-1 h-1 rounded-full bg-{{ color }}-500 {% if status != 'Paid' %}animate-pulse{% endif %}"></span>
                                {{ status }}
                            </div>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-1">
                                <a href="{{ path('app_' ~ type ~ 's_show', {'slug': item.slug}) }}" class="p-2.5 text-slate-400 hover:text-indigo-600 hover:bg-white rounded-xl transition-all border border-transparent hover:border-slate-100 shadow-sm hover:shadow-md" title="View Details">
                                    <i data-lucide="eye" class="w-4 h-4"></i>
                                </a>
                                <a href="{{ path('app_' ~ type ~ 's_edit', {'slug': item.slug}) }}" class="p-2.5 text-slate-400 hover:text-amber-600 hover:bg-white rounded-xl transition-all border border-transparent hover:border-slate-100 shadow-sm hover:shadow-md" title="Edit">
                                    <i data-lucide="pencil" class="w-4 h-4"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="px-6 py-20 text-center text-slate-400">
                            <div class="flex flex-col items-center gap-4">
                                <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center text-slate-300">
                                    <i data-lucide="{{ empty_icon }}" class="w-10 h-10"></i>
                                </div>
                                <div>
                                    <p class="text-base font-bold text-slate-900">{{ empty_title }}</p>
                                    <p class="text-sm text-slate-500 mt-1">{{ empty_desc }}</p>
                                </div>
                                <a href="{{ path(empty_route) }}" class="mt-2 inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-sm transition-all focus:ring-4 focus:ring-indigo-500/20 active:scale-95">
                                    <i data-lucide="plus" class="w-4 h-4"></i>
                                    {{ empty_action_text }}
                                </a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'components/_pagination.html.twig' with {
        items: items,
        pagesCount: pagesCount,
        currentPage: currentPage,
        totalItems: totalItems
    } %}
</div>
