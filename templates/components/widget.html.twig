<div class="rounded-xl border border-slate-200 bg-white shadow-sm flex flex-col justify-between p-6 transition-all hover:bg-slate-50/50">
    <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-medium text-slate-500">{{ title|default('Widget Title') }}</h3>
        <i data-lucide="{{ icon|default('activity') }}" class="w-4 h-4 text-slate-400"></i>
    </div>
    <div class="flex flex-col gap-1">
        <div {% if value_id is defined %}id="{{ value_id }}"{% endif %} class="text-2xl font-bold tracking-tight {{ value_class|default('text-slate-900') }}">{{ value|default('0') }}</div>
        
        {% if (change is defined and change is not null) or (change_text is defined and change_text is not null) %}
            <div {% if change_container_id is defined %}id="{{ change_container_id }}"{% endif %} class="flex items-center text-xs font-medium {% if change_type|default('up') == 'up' %}text-emerald-600{% elseif change_type == 'neutral' %}text-slate-500{% else %}text-rose-600{% endif %} mt-1">
                {% if change_icon is defined and change_icon %}
                    <i {% if change_icon_id is defined %}id="{{ change_icon_id }}"{% endif %} data-lucide="{{ change_icon }}" class="w-3 h-3 mr-1"></i>
                {% elseif change_icon is not defined and change is defined %}
                    {% if change_type|default('up') == 'up' %}
                        <i data-lucide="trending-up" class="w-3 h-3 mr-1"></i>
                    {% elseif change_type == 'neutral' %}
                        <i data-lucide="minus" class="w-3 h-3 mr-1"></i>
                    {% else %}
                        <i data-lucide="trending-down" class="w-3 h-3 mr-1"></i>
                    {% endif %}
                {% endif %}
                
                {% if change is defined and change is not empty %}
                    <span {% if change_id is defined %}id="{{ change_id }}"{% endif %}>{{ change }}</span>
                {% endif %}
                
                {% if change_text is defined and change_text is not null %}
                    <span class="text-slate-400 font-normal {% if change is defined and change is not empty %}ml-1{% endif %}" {% if change_text_id is defined %}id="{{ change_text_id }}"{% endif %}>{{ change_text }}</span>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
