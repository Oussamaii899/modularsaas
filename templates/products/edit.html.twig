{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Edit Product | {{ company_name ?? 'ModularSaaS' }}{% endblock %}

{% block content_title %}Edit Product{% endblock %}
{% block content_subtitle %}Updating {{ product.name }}{% endblock %}

{% block content_actions %}
    <a href="{{ path('app_products_index') }}" class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 rounded-md shadow-sm transition-colors">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        <span>Back to List</span>
    </a>
{% endblock %}

{% block main_content %}
    <div class="max-w-3xl mx-auto pb-12">
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="p-6 md:p-8">
                <div class="mb-8">
                    <h3 class="text-lg font-bold text-slate-900">Product Information</h3>
                    <p class="text-sm text-slate-500 mt-1">Please specify catalog identifiers and inventory metrics.</p>
                </div>

                {{ form_start(form, {'attr': {'class': 'space-y-6', 'id': 'product-edit-form'}}) }}
                    <input type="hidden" name="clearImage" id="clear-image-input" value="0">
                    <input type="hidden" name="deletedScreens" id="deleted-screens-input" value="">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-3">
                            <label class="text-sm font-semibold text-slate-900">Product Name</label>
                            {{ form_widget(form.name, {'attr': {'class': 'w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-sm font-medium text-slate-900 placeholder-slate-400', 'placeholder': 'e.g. Wireless Mouse'}}) }}
                            <div class="text-rose-500 text-xs font-medium mt-1">{{ form_errors(form.name) }}</div>
                        </div>
                        <div class="space-y-3">
                            <label class="text-sm font-semibold text-slate-900">Product SKU</label>
                            {{ form_widget(form.sku, {'attr': {'class': 'w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-sm font-medium text-slate-900 placeholder-slate-400', 'placeholder': 'e.g. PRD-001'}}) }}
                            <div class="text-rose-500 text-xs font-medium mt-1">{{ form_errors(form.sku) }}</div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-3">
                            <label class="text-sm font-semibold text-slate-900">Unit Price ($)</label>
                            {{ form_widget(form.price, {'attr': {'class': 'w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-sm font-medium text-slate-900 placeholder-slate-400', 'placeholder': '0.00'}}) }}
                            <div class="text-rose-500 text-xs font-medium mt-1">{{ form_errors(form.price) }}</div>
                        </div>
                        <div class="space-y-3">
                            <label class="text-sm font-semibold text-slate-900">Current Stock Level</label>
                            {{ form_widget(form.stockQuantity, {'attr': {'class': 'w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-sm font-medium text-slate-900 placeholder-slate-400', 'placeholder': '0'}}) }}
                            <div class="text-rose-500 text-xs font-medium mt-1">{{ form_errors(form.stockQuantity) }}</div>
                        </div>
                    </div>

                    <div class="space-y-3">
                        <label class="text-sm font-semibold text-slate-900">Product Description</label>
                        {{ form_widget(form.description, {'attr': {'class': 'w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-sm font-medium text-slate-900 placeholder-slate-400', 'placeholder': 'Add some notes or details about the product...', 'rows': 4, 'style': 'font-family: inherit; font-size: 14px; outline: none; border: 1px solid #e2e8f0; border-radius: 8px;'}}) }}
                        <div class="text-rose-500 text-xs font-medium mt-1">{{ form_errors(form.description) }}</div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-slate-100">
                        <div class="space-y-3" style="display:flex;flex-direction:column;gap:0.75rem;">
                            <label class="text-sm font-semibold text-slate-900">Main Product Photo</label>
                            <label for="{{ form.imageFile.vars.id }}" class="relative upload-zone rounded-xl p-6 flex flex-col items-center justify-center cursor-pointer transition-all group" style="min-height:8.5rem;display:flex;align-items:center;justify-content:center;cursor:pointer;">
                                <div id="image-upload-prompt" class="flex flex-col items-center text-center">
                                    <i data-lucide="image" class="w-8 h-8 text-slate-400 group-hover:text-indigo-500 transition-colors mb-2"></i>
                                    <span class="text-sm font-semibold text-slate-700">{{ product.image ? 'Change Main Image' : 'Upload Main Image' }}</span>
                                    <span class="text-xs text-slate-500 mt-1">Drag and drop or click to browse</span>
                                </div>
                            </label>
                            {{ form_widget(form.imageFile, {'attr': {'class': 'sr-only', 'onchange': 'previewMainImage(this)'}}) }}
                            <div id="image-preview-card" class="items-center gap-3 preview-card p-2 shadow-sm rounded-lg" style="{{ product.image ? 'display:flex;' : 'display:none;' }}width:100%;max-width:24rem;align-items:center;gap:0.875rem;padding:0.75rem;border-radius:0.75rem;">
                                <div class="rounded-md border border-slate-200 bg-slate-50 overflow-hidden" style="width:6.5rem;height:4.5rem;min-width:6.5rem;border-radius:0.5rem;overflow:hidden;">
                                    <img id="image-preview" src="{% if product.image %}{{ asset('uploads/products/' ~ product.image) }}{% endif %}" class="w-full h-full object-contain" style="width:100%;height:100%;object-fit:contain;" alt="Product Preview">
                                </div>
                                <div class="min-w-0" style="min-width:0;">
                                    <p class="text-xs font-semibold text-slate-700" style="font-size:0.8rem;font-weight:700;color:#334155;margin:0;">Current main image</p>
                                    <button id="clear-main-image-button" type="button" onclick="clearMainImageSelection()" class="{% if not product.image %}hidden{% endif %}" style="margin-top:0.5rem;border:0;border-radius:0.5rem;background:#fee2e2;color:#b91c1c;padding:0.45rem 0.75rem;font-size:0.75rem;font-weight:700;cursor:pointer;">
                                        Clear image
                                    </button>
                                </div>
                            </div>
                            <p class="text-[10px] text-slate-400">Supported formats: JPG, PNG, WebP, GIF up to 5MB</p>
                            <div class="text-rose-500 text-xs font-medium mt-1">{{ form_errors(form.imageFile) }}</div>
                        </div>

                        <div class="space-y-3">
                            <label class="text-sm font-semibold text-slate-900">Upload New Screenshots</label>
                            <label for="{{ form.screenFiles.vars.id }}" class="relative upload-zone rounded-xl p-6 flex flex-col items-center justify-center cursor-pointer transition-all min-h-[160px] group">
                                <div class="flex flex-col items-center text-center">
                                    <i data-lucide="images" class="w-8 h-8 text-slate-400 group-hover:text-indigo-500 transition-colors mb-2"></i>
                                    <span class="text-sm font-semibold text-slate-700">Upload Screenshots</span>
                                    <span class="text-xs text-slate-500 mt-1">Select multiple images</span>
                                </div>
                            </label>
                            {{ form_widget(form.screenFiles, {'attr': {'class': 'sr-only', 'onchange': 'previewScreenshots(this)'}}) }}
                            <button id="clear-screens-button" type="button" onclick="clearSelectedScreenshots()" class="hidden" style="border:0;border-radius:0.5rem;background:#fee2e2;color:#b91c1c;padding:0.45rem 0.75rem;font-size:0.75rem;font-weight:700;cursor:pointer;width:max-content;">
                                Clear selected screenshots
                            </button>
                            <p class="text-[10px] text-slate-400">Upload multiple screenshots to showcase various angles/views</p>
                            <div class="text-rose-500 text-xs font-medium mt-1">{{ form_errors(form.screenFiles) }}</div>
                        </div>
                    </div>

                    <!-- Selected Screenshots Preview Grid -->
                    <div id="screens-preview-container" class="hidden space-y-3">
                        <label class="text-xs font-bold text-slate-500 uppercase tracking-wider text-indigo-600">New Screenshots Selected</label>
                        <div id="screens-preview-grid" style="display:flex;flex-wrap:wrap;gap:0.75rem;">
                            <!-- JS will inject preview cards here -->
                        </div>
                    </div>

                    <!-- Existing Screenshots Grid -->
                    {% if product.screens|length > 0 %}
                        <div id="existing-screens-container" class="space-y-3 pt-4 border-t border-slate-100">
                            <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
                                <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Current Screenshots</label>
                                <button type="button" onclick="deleteSelectedScreens()" style="border:0;border-radius:0.5rem;background:#dc2626;color:#fff;padding:0.5rem 0.875rem;font-size:0.75rem;font-weight:700;cursor:pointer;box-shadow:0 1px 2px rgba(15,23,42,0.12);">
                                    Delete selected
                                </button>
                            </div>
                            <div style="display:flex;flex-wrap:wrap;gap:1rem;">
                                {% for screen in product.screens %}
                                    <div id="screen-card-{{ screen.id }}" class="relative rounded-lg overflow-hidden border border-slate-200 bg-white group shadow-sm transition-all duration-300 transform hover:shadow-md" style="width:10rem;height:6rem;">
                                        <img src="{{ asset('uploads/products/' ~ screen.url) }}" class="w-full h-full object-cover" style="width:100%;height:100%;object-fit:cover;">
                                        <label title="Select screenshot" style="position:absolute;top:0.4rem;right:0.4rem;width:1.4rem;height:1.4rem;border-radius:0.375rem;background:rgba(255,255,255,0.92);display:flex;align-items:center;justify-content:center;box-shadow:0 1px 4px rgba(15,23,42,0.2);cursor:pointer;">
                                            <input type="checkbox" class="screen-delete-checkbox" value="{{ screen.id }}" style="width:0.95rem;height:0.95rem;accent-color:#dc2626;cursor:pointer;">
                                        </label>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    <div class="pt-8 flex items-center justify-end">
                        <a href="{{ path('app_products_index') }}" class="inline-block px-14 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-100 rounded-lg transition-colors" style="margin-right: 40px;padding:10px;">Discard Changes</a>
                        <button id="update-product-button" type="submit" disabled class="inline-flex items-center gap-2 px-20 py-2.5 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm transition-colors active:scale-95" style="padding:10px;opacity:0.45;cursor:not-allowed;">
                            <span class="px-5">Update Product</span>
                            <i data-lucide="save" class="w-4 h-4 text-white"></i>
                        </button>
                    </div>
                {{ form_end(form) }}

                <script>
                    let initialProductFormState = '';
                    const stagedDeletedScreens = new Set();

                    function getProductFormState() {
                        const form = document.getElementById('product-edit-form');
                        if (!form) return '';

                        const values = [];
                        form.querySelectorAll('input, textarea, select').forEach((field) => {
                            if (field.classList.contains('screen-delete-checkbox')) {
                                return;
                            }

                            if (field.type === 'file') {
                                values.push(`${field.name}:files:${field.files.length}`);
                                return;
                            }

                            if (field.type === 'checkbox' || field.type === 'radio') {
                                values.push(`${field.name}:${field.checked}:${field.value}`);
                                return;
                            }

                            values.push(`${field.name}:${field.value}`);
                        });

                        return JSON.stringify(values);
                    }

                    function updateProductSubmitState() {
                        const button = document.getElementById('update-product-button');
                        if (!button) return;

                        const hasChanges = getProductFormState() !== initialProductFormState;
                        button.disabled = !hasChanges;
                        button.style.opacity = hasChanges ? '1' : '0.45';
                        button.style.cursor = hasChanges ? 'pointer' : 'not-allowed';
                    }

                    function previewMainImage(input) {
                        if (input.files && input.files[0]) {
                            const reader = new FileReader();
                            reader.onload = function(e) {
                                const preview = document.getElementById('image-preview');
                                const previewCard = document.getElementById('image-preview-card');
                                
                                preview.src = e.target.result;
                                previewCard.style.display = 'flex';
                                document.getElementById('clear-image-input').value = '0';
                                document.getElementById('clear-main-image-button')?.classList.remove('hidden');
                                updateProductSubmitState();
                            }
                            reader.readAsDataURL(input.files[0]);
                        }
                    }

                    function clearMainImageSelection() {
                        const input = document.getElementById('{{ form.imageFile.vars.id }}');
                        const clearInput = document.getElementById('clear-image-input');
                        const preview = document.getElementById('image-preview');
                        const previewCard = document.getElementById('image-preview-card');
                        const clearButton = document.getElementById('clear-main-image-button');

                        if (input) {
                            input.value = '';
                        }
                        if (clearInput) {
                            clearInput.value = '1';
                        }
                        if (preview) {
                            preview.src = '';
                        }
                        if (previewCard) {
                            previewCard.style.display = 'none';
                        }
                        clearButton?.classList.add('hidden');
                        updateProductSubmitState();
                    }

                    function previewScreenshots(input) {
                        const container = document.getElementById('screens-preview-container');
                        const grid = document.getElementById('screens-preview-grid');
                        const clearButton = document.getElementById('clear-screens-button');
                        
                        grid.innerHTML = '';
                        
                        if (input.files && input.files.length > 0) {
                            container.classList.remove('hidden');
                            clearButton?.classList.remove('hidden');
                            
                            Array.from(input.files).forEach((file, index) => {
                                const reader = new FileReader();
                                reader.onload = function(e) {
                                    const card = document.createElement('div');
                                    card.className = 'relative aspect-video rounded-lg overflow-hidden border border-slate-200 bg-white group shadow-sm';
                                    card.style.width = '10rem';
                                    card.style.height = '6rem';
                                    card.innerHTML = `
                                        <img src="${e.target.result}" class="w-full h-full object-cover" style="width:100%;height:100%;object-fit:cover;">
                                        <div class="absolute inset-0 bg-slate-950/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                            <span class="text-[9px] font-bold text-white px-2 py-0.5 bg-slate-900/60 rounded-full truncate max-w-[90%]">${file.name}</span>
                                        </div>
                                    `;
                                    grid.appendChild(card);
                                }
                                reader.readAsDataURL(file);
                            });
                        } else {
                            container.classList.add('hidden');
                            clearButton?.classList.add('hidden');
                        }
                        updateProductSubmitState();
                    }

                    function clearSelectedScreenshots() {
                        const input = document.getElementById('{{ form.screenFiles.vars.id }}');
                        const container = document.getElementById('screens-preview-container');
                        const grid = document.getElementById('screens-preview-grid');
                        const clearButton = document.getElementById('clear-screens-button');

                        if (input) {
                            input.value = '';
                        }
                        if (grid) {
                            grid.innerHTML = '';
                        }
                        container?.classList.add('hidden');
                        clearButton?.classList.add('hidden');
                        updateProductSubmitState();
                    }

                    function deleteSelectedScreens() {
                        const selected = Array.from(document.querySelectorAll('.screen-delete-checkbox:checked'));
                        if (selected.length === 0) {
                            return;
                        }

                        selected.forEach((checkbox) => stageExistingScreenDelete(checkbox.value));
                        updateProductSubmitState();
                    }

                    function stageExistingScreenDelete(id) {
                        const card = document.getElementById('screen-card-' + id);
                        const deletedScreensInput = document.getElementById('deleted-screens-input');
                        if (!card || !deletedScreensInput) {
                            return;
                        }

                        stagedDeletedScreens.add(String(id));
                        deletedScreensInput.value = Array.from(stagedDeletedScreens).join(',');
                        card.style.display = 'none';
                    }

                    document.addEventListener('DOMContentLoaded', () => {
                        initialProductFormState = getProductFormState();
                        updateProductSubmitState();

                        const form = document.getElementById('product-edit-form');
                        if (!form) return;

                        form.addEventListener('input', (event) => {
                            if (!event.target.classList.contains('screen-delete-checkbox')) {
                                updateProductSubmitState();
                            }
                        });
                        form.addEventListener('change', (event) => {
                            if (!event.target.classList.contains('screen-delete-checkbox')) {
                                updateProductSubmitState();
                            }
                        });
                    });
                </script>
            </div>
        </div>
    </div>
{% endblock %}
