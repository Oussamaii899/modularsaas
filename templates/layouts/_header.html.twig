<header class="sticky top-0 z-40 w-full bg-white/80 backdrop-blur-md border-b border-slate-200">
    <div class="h-16 px-4 sm:px-6 lg:px-8 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <!-- Mobile Menu Toggle -->
            <button type="button" id="mobile-menu-toggle" class="inline-flex items-center p-2 text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg lg:hidden transition-all duration-200">
                <i data-lucide="menu" class="w-6 h-6"></i>
            </button>
            <div class="flex items-center gap-2 text-sm text-slate-500 font-medium">
                <a href="{{ path('app_dashboard') }}" class="hover:text-indigo-600 transition-colors">App</a>
                {% for crumb in breadcrumbs|default([]) %}
                    <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
                    {% if not loop.last %}
                        <a href="{{ crumb.url }}" class="hover:text-indigo-600 transition-colors">{{ crumb.label }}</a>
                    {% else %}
                        <span class="text-slate-900 font-semibold">{{ crumb.label }}</span>
                    {% endif %}
                {% endfor %}
                {% if breadcrumbs|default([]) is empty %}
                    <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
                    <span class="text-slate-900 font-semibold">{% block header_title %}Dashboard{% endblock %}</span>
                {% endif %}
            </div>
        </div>

        <div class="flex items-center gap-3 sm:gap-6">
            <!-- Search -->
            <div class="relative hidden sm:block">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i data-lucide="search" class="w-4 h-4 text-slate-400"></i>
                </div>
                <input type="text" name="search" id="search" class="block w-64 pl-10 pr-3 py-2 border border-slate-200 rounded-lg bg-slate-50 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all duration-200" placeholder="Search anything...">
            </div>

            <!-- Notifications -->
            <button type="button" class="relative p-2 text-slate-500 hover:text-indigo-600 hover:bg-slate-50 rounded-lg transition-all duration-200">
                <i data-lucide="bell" class="w-5 h-5"></i>
                <span class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
            </button>

            <!-- Theme Toggle -->
            <button type="button" id="theme-toggle" class="p-2 text-slate-500 hover:text-indigo-600 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-all duration-200" aria-label="Toggle theme">
                <i data-lucide="sun" class="w-5 h-5 hidden dark:block"></i>
                <i data-lucide="moon" class="w-5 h-5 block dark:hidden"></i>
            </button>

            <!-- User Menu Button -->
            <button type="button" class="flex items-center gap-2 p-1 pl-2 text-slate-700 hover:bg-slate-100 rounded-full transition-all duration-200 border border-slate-100 shadow-sm sm:shadow-none bg-white sm:bg-transparent">
                <span class="hidden sm:inline-block text-xs font-semibold mr-1">{{ app.user.username }}</span>
                <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 overflow-hidden flex-shrink-0">
                    <img src="{{ app.user.avatar ? asset('uploads/avatars/' ~ app.user.avatar) : 'https://ui-avatars.com/api/?name=' ~ app.user.username ~ '&background=6366f1&color=fff' }}" alt="Avatar" class="w-full h-full object-cover">
                </div>
            </button>
        </div>
    </div>
</header>
