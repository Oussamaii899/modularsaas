{% extends 'layouts/dashboard.html.twig' %}

{% block title %}System Audit Logs | {{ company_name ?? 'ModularSaaS' }}{% endblock %}

{% block content_title %}System Audit Logs{% endblock %}
{% block content_subtitle %}Track operations and record changes across all modules{% endblock %}

{% block content_actions %}
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center w-full sm:w-auto gap-2 sm:gap-3">
        <!-- Search and Filters Form -->
        <form id="filtersForm" action="{{ path('app_logs_index') }}" method="get" class="flex flex-wrap items-center gap-4 sm:gap-5 w-full sm:w-auto">
            <!-- Search Input -->
            <div class="relative flex-1 sm:flex-none">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                    <i data-lucide="search" class="w-4 h-4 text-slate-400" style="margin-left: 10px;"></i>
                </div>
                <input type="text" name="q" value="{{ searchQuery }}" placeholder="Search logs..." class="block w-full sm:w-[250px] h-10 pl-10 pr-4 py-2 text-sm bg-white border border-slate-200 rounded-lg placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all shadow-sm">
            </div>

            <!-- Action Filter -->
            <select name="action" onchange="this.form.submit()" class="h-10 px-3 text-sm bg-white border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 shadow-sm">
                <option value="">All Actions</option>
                <option value="CREATE" {{ actionFilter == 'CREATE' ? 'selected' : '' }}>Create</option>
                <option value="UPDATE" {{ actionFilter == 'UPDATE' ? 'selected' : '' }}>Update</option>
                <option value="DELETE" {{ actionFilter == 'DELETE' ? 'selected' : '' }}>Delete</option>
            </select>

            <!-- User Filter -->
            <select name="user" onchange="this.form.submit()" class="h-10 px-3 text-sm bg-white border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 shadow-sm max-w-[150px]">
                <option value="">All Users</option>
                {% for u in users %}
                    <option value="{{ u.id }}" {{ userIdFilter == u.id ? 'selected' : '' }}>{{ u.username }}</option>
                {% endfor %}
            </select>

            <!-- Maintain Sort parameters -->
            <input type="hidden" name="sort" value="{{ sortField }}">
            <input type="hidden" name="direction" value="{{ sortOrder }}">

            <!-- Reset Button -->
            {% if searchQuery or actionFilter or userIdFilter %}
                <a href="{{ path('app_logs_index') }}" class="inline-flex h-10 px-3 items-center justify-center text-sm font-semibold text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 rounded-lg transition-colors shadow-sm" title="Clear Filters">
                    <i data-lucide="rotate-ccw" class="w-4 h-4 text-slate-500"></i>
                </a>
            {% endif %}
        </form>
    </div>
{% endblock %}

{% block main_content %}
    {% set next_dir = sortOrder == 'ASC' ? 'DESC' : 'ASC' %}
    {% macro sort_link(field, label, current_field, current_dir, next_dir, q, action, user) %}
        <a href="{{ path('app_logs_index', {sort: field, direction: (current_field == field ? next_dir : 'DESC'), q: q, action: action, user: user}) }}" class="inline-flex items-center gap-1 hover:text-indigo-600 font-semibold text-slate-500">
            {{ label }}
            {% if current_field == field %}
                <i data-lucide="{{ current_dir == 'ASC' ? 'chevron-up' : 'chevron-down' }}" class="w-3.5 h-3.5 text-indigo-600"></i>
            {% else %}
                <i data-lucide="chevrons-up-down" class="w-3.5 h-3.5 text-slate-400"></i>
            {% endif %}
        </a>
    {% endmacro %}
    {% import _self as sortable %}

    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden min-h-[400px]">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50/30 transition-colors select-none">
                        <th class="h-12 px-4 align-middle text-center uppercase tracking-wider text-[11px]">
                            {{ sortable.sort_link('action', 'Action Type', sortField, sortOrder, next_dir, searchQuery, actionFilter, userIdFilter) }}
                        </th>
                        <th class="h-12 px-4 align-middle text-left uppercase tracking-wider text-[11px]">
                            {{ sortable.sort_link('user', 'Done By', sortField, sortOrder, next_dir, searchQuery, actionFilter, userIdFilter) }}
                        </th>
                        <th class="h-12 px-4 align-middle text-left uppercase tracking-wider text-[11px]">
                            {{ sortable.sort_link('entity', 'Target Resource', sortField, sortOrder, next_dir, searchQuery, actionFilter, userIdFilter) }}
                        </th>
                        <th class="h-12 px-4 align-middle text-left uppercase tracking-wider text-[11px] text-slate-500 font-semibold">Description</th>
                        <th class="h-12 px-4 align-middle text-left uppercase tracking-wider text-[11px]">
                            {{ sortable.sort_link('createdAt', 'Timestamp', sortField, sortOrder, next_dir, searchQuery, actionFilter, userIdFilter) }}
                        </th>
                        <th class="h-12 px-4 align-middle font-semibold text-slate-500 text-center uppercase tracking-wider text-[11px]">Details</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for log in logs %}
                        <tr class="hover:bg-slate-50/80 transition-colors group">
                            <td class="p-4 align-middle text-center whitespace-nowrap">
                                {% if log.action == 'CREATE' %}
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-100">
                                        CREATE
                                    </span>
                                {% elseif log.action == 'UPDATE' %}
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-100">
                                        UPDATE
                                    </span>
                                {% elseif log.action == 'DELETE' %}
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-100">
                                        DELETE
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-slate-50 text-slate-700 border border-slate-100">
                                        {{ log.action }}
                                    </span>
                                {% endif %}
                            </td>
                            <td class="p-4 align-middle whitespace-nowrap">
                                {% if log.user %}
                                    <div class="flex items-center gap-2">
                                        <div class="w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 font-semibold border border-slate-200 overflow-hidden flex-shrink-0">
                                            <img src="{{ log.user.avatar ? asset('uploads/avatars/' ~ log.user.avatar) : 'https://ui-avatars.com/api/?name=' ~ log.user.username ~ '&background=6366f1&color=fff' }}" alt="Avatar" class="w-full h-full object-cover">
                                        </div>
                                        <span class="font-medium text-slate-900">{{ log.user.username }}</span>
                                    </div>
                                {% else %}
                                    <span class="text-slate-400 italic text-xs">System / CLI</span>
                                {% endif %}
                            </td>
                            <td class="p-4 align-middle">
                                <div class="flex flex-col">
                                    <span class="font-medium text-slate-700 text-xs">{{ log.entityClass ? log.entityClass|split('\\')|last : 'N/A' }}</span>
                                    {% if log.entityId %}
                                        <span class="text-[10px] font-mono text-slate-400">ID: {{ log.entityId }}</span>
                                    {% endif %}
                                </div>
                            </td>
                            <td class="p-4 align-middle text-slate-600 text-xs">
                                {{ log.details }}
                            </td>
                            <td class="p-4 align-middle whitespace-nowrap text-slate-500 text-xs font-mono">
                                {{ log.createdAt|date('Y-m-d H:i:s') }}
                            </td>
                            <td class="p-4 align-middle text-center">
                                <div class="flex items-center justify-center gap-1">
                                    <a href="{{ path('app_logs_show', {'id': log.id}) }}" class="p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all" title="Inspect Record Diff">
                                        <i data-lucide="eye" class="w-4.5 h-4.5"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="p-8 text-center text-slate-500">
                                <div class="flex flex-col items-center gap-3">
                                    <i data-lucide="file-text" class="w-8 h-8 text-slate-300"></i>
                                    <div class="flex flex-col gap-1">
                                        <p class="font-medium text-slate-900">No logs found</p>
                                        <p class="text-sm">Try clearing filters or search to view more records</p>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% include 'components/_pagination.html.twig' with {
            items: logs,
            pagesCount: pagesCount|default(0),
            currentPage: currentPage|default(1),
            totalItems: totalItems|default(0)
        } %}
    </div>
{% endblock %}
