{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Dashboard | ModularSaaS{% endblock %}

{% block content_title %}Dashboard{% endblock %}
{% block content_subtitle %}Financial & Stock Overview{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
    <link rel="stylesheet" href="{{ asset('styles/dashboard.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <!-- Core JS Dependencies -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/moment/min/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    
    <!-- Dashboard Logic -->
    <script src="{{ asset('dashboard.js') }}" defer></script>
{% endblock %}

{% block content_actions %}
    <!-- Daterangepicker Button -->
    <div id="reportrange" class="flex items-center gap-2 bg-white border border-slate-200 hover:border-slate-300 rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-700 cursor-pointer shadow-sm transition-all">
        <i data-lucide="calendar" class="w-4 h-4 text-indigo-600"></i>
        <span></span>
        <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 ml-1"></i>
    </div>
    
    <button id="dashboard-export-btn" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-semibold text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl shadow-sm transition-all duration-200 hover:scale-105 ml-2">
        <i data-lucide="download" class="w-4 h-4"></i>
        <span class="hidden sm:inline">Export</span>
    </button>
{% endblock %}


{% block main_content %}
    <div class="space-y-6" id="dashboard-container" data-data-url="{{ path('dashboard_data') }}">
        <!-- 1. Stats Widgets -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {% include 'components/widget.html.twig' with {
                title: 'Total Sales',
                value: '$' ~ total_sales|number_format(2),
                value_id: 'total-sales-value',
                icon: 'trending-up',
                change_type: 'neutral',
                change_text: 'Last 30 Days',
                change_text_id: 'total-sales-change-text'
            } %}
            {% include 'components/widget.html.twig' with {
                title: 'Total Purchases',
                value: '$' ~ total_purchases|number_format(2),
                value_id: 'total-purchases-value',
                icon: 'shopping-bag',
                change_type: 'neutral',
                change_text: 'Last 30 Days',
                change_text_id: 'total-purchases-change-text'
            } %}
            {% set net_sales = total_sales - total_refunded_sales|abs %}
            {% set net_purchases = total_purchases - total_refunded_purchases|abs %}
            {% include 'components/widget.html.twig' with {
                title: 'Net Profit',
                value: (net_sales - net_purchases) > 0 ? '$' ~ (net_sales - net_purchases)|number_format(2) : '$0.00',
                value_id: 'net-profit-value',
                icon: 'dollar-sign',
                change_type: 'neutral',
                change_text: 'Last 30 Days',
                change_text_id: 'net-profit-change-text'
            } %}
            {% include 'components/widget.html.twig' with {
                title: 'Net Loss',
                value: (net_purchases - net_sales) > 0 ? '$' ~ (net_purchases - net_sales)|number_format(2) : '$0.00',
                value_id: 'net-loss-value',
                icon: 'trending-down',
                change_type: 'neutral',
                change_text: 'Last 30 Days',
                change_text_id: 'net-loss-change-text'
            } %}
        </div>

        <!-- Detailed Metrics Row -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {% include 'components/widget.html.twig' with {
                title: 'Customer Refunds',
                value: '$' ~ total_refunded_sales|number_format(2),
                value_id: 'customer-refunds-value',
                icon: 'refresh-cw',
                change_type: 'neutral',
                change_text: 'Last 30 Days',
                change_text_id: 'customer-refunds-change-text'
            } %}
            {% include 'components/widget.html.twig' with {
                title: 'Supplier Refunds',
                value: '$' ~ total_refunded_purchases|number_format(2),
                value_id: 'supplier-refunds-value',
                icon: 'reply',
                change_type: 'neutral',
                change_text: 'Last 30 Days',
                change_text_id: 'supplier-refunds-change-text'
            } %}
            {% include 'components/widget.html.twig' with {
                title: 'Total Receivables',
                value: '$' ~ total_outstanding_sales|number_format(2),
                value_id: 'sales-receivables-value',
                icon: 'clock',
                change_type: 'neutral',
                change_text: 'Last 30 Days',
                change_text_id: 'sales-receivables-change-text'
            } %}
            {% include 'components/widget.html.twig' with {
                title: 'Total Payables',
                value: '$' ~ total_outstanding_purchases|number_format(2),
                value_id: 'purchases-payables-value',
                icon: 'credit-card',
                change_type: 'neutral',
                change_text: 'Last 30 Days',
                change_text_id: 'purchases-payables-change-text'
            } %}
        </div>

        <!-- 2. Graphs & Charts Row (Ratio 70/30) -->
        <div style="display: flex; flex-wrap: wrap; gap: 1.5rem;">
            <!-- Line/Bar Graph (70%) -->
            <div class="p-6 bg-white border border-slate-200 rounded-2xl shadow-sm flex flex-col hover:shadow-md transition-shadow" style="flex: 1 1 calc(70% - 1.5rem); min-width: 320px;">
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 tracking-tight">Sales vs Purchases</h3>
                        <p class="text-sm text-slate-500">Monthly breakdown for the current year</p>
                    </div>
                    <button class="p-2 hover:bg-slate-50 rounded-lg text-slate-400 transition-colors"><i data-lucide="more-horizontal" class="w-5 h-5"></i></button>
                </div>
                <div class="flex-1 relative w-full min-h-[320px]">
                    <canvas id="mainChart"></canvas>
                </div>
            </div>
            
            <!-- Pie Chart (30%) -->
            <div class="p-6 bg-white border border-slate-200 rounded-2xl shadow-sm flex flex-col hover:shadow-md transition-shadow" style="flex: 1 1 calc(30% - 1.5rem); min-width: 320px;">
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 tracking-tight">Sales by Product</h3>
                        <p class="text-sm text-slate-500">Distribution of revenue</p>
                    </div>
                    <button class="p-2 hover:bg-slate-50 rounded-lg text-slate-400 transition-colors"><i data-lucide="more-horizontal" class="w-5 h-5"></i></button>
                </div>
                <!-- Centered canvas wrapper -->
                <div class="flex-1 relative w-full min-h-[320px] flex items-center justify-center">
                    <canvas id="pieChart"></canvas>
                </div>
            </div>
        </div>

        <!-- 3. Lists Row -> Product Stock & Recent Activities -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Product Stock -->
            <div class="h-full p-6 bg-white border border-slate-200 rounded-2xl shadow-sm hover:shadow-md transition-shadow flex flex-col">
                <div class="flex items-center justify-between mb-6 flex-shrink-0">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 tracking-tight">Product Stock Alert</h3>
                        <p class="text-sm text-slate-500">Items requiring your attention</p>
                    </div>
                    <a href="#" class="text-sm font-bold text-indigo-600 hover:text-indigo-700 transition-colors bg-indigo-50 hover:bg-indigo-100 px-4 py-2 rounded-xl">View All</a>
                </div>
                <div id="stock-alerts-list" class="space-y-4 flex-1">
                    <!-- Dynamic stock alerts will be injected here -->
                </div>
            </div>

            <!-- Recent Sales / Purchases -->
            <div class="h-full p-6 bg-white border border-slate-200 rounded-2xl shadow-sm hover:shadow-md transition-shadow flex flex-col">
                <div class="flex items-center justify-between mb-6 flex-shrink-0">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 tracking-tight">Recent Transactions</h3>
                        <p class="text-sm text-slate-500">Latest sales and purchases</p>
                    </div>
                    <a href="#" class="text-sm font-bold text-indigo-600 hover:text-indigo-700 transition-colors bg-indigo-50 hover:bg-indigo-100 px-4 py-2 rounded-xl">View Report</a>
                </div>
                <div id="recent-transactions-list" class="space-y-4 flex-1">
                    <!-- Dynamic transactions will be injected here -->
                </div>
            </div>
        </div>
    </div>

{% endblock %}
