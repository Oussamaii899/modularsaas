{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Edit User | {{ company_name ?? 'ModularSaaS' }}{% endblock %}

{% block content_title %}Edit User: {{ targetUser.username }}{% endblock %}
{% block content_subtitle %}Modify account credentials and customize access permissions{% endblock %}

{% block content_actions %}
    <a href="{{ path('app_users_index') }}" class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 rounded-md shadow-sm transition-colors">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        <span>Back to List</span>
    </a>
{% endblock %}

{% block main_content %}
    {# Admin Confirmation Dialog #}
    <dialog id="adminConfirmDialog" style="margin:auto;border:none;padding:0;border-radius:0.75rem;box-shadow:0 25px 50px -12px rgba(0,0,0,0.25);max-width:28rem;width:100%;">
        <div style="background:#fff;text-align:left;">
            <div style="padding:1.5rem;">
                <div style="display:flex;align-items:flex-start;gap:1rem;margin-bottom:1.25rem;">
                    <div style="width:2.5rem;height:2.5rem;border-radius:9999px;background:#eef2ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i data-lucide="shield-alert" style="width:1.25rem;height:1.25rem;color:#4f46e5;"></i>
                    </div>
                    <div style="flex:1;">
                        <h3 style="font-size:1rem;font-weight:700;color:#0f172a;line-height:1.25;margin:0 0 0.5rem;">Grant Administrator Privileges?</h3>
                        <p style="font-size:0.875rem;color:#64748b;line-height:1.5;margin:0;">This will give the user full access to all data and features, bypassing all granular permission settings.</p>
                    </div>
                </div>
                <div style="display:flex;justify-content:flex-end;gap:0.75rem;margin-top:1.5rem;">
                    <button type="button" id="adminConfirmCancel" style="padding:0.5rem 1rem;font-size:0.875rem;font-weight:600;color:#374151;background:#fff;border:1px solid #e2e8f0;border-radius:0.5rem;cursor:pointer;">Cancel</button>
                    <button type="button" id="adminConfirmOk" style="padding:0.5rem 1rem;font-size:0.875rem;font-weight:700;color:#fff;background:#4f46e5;border:none;border-radius:0.5rem;cursor:pointer;">Yes, Grant Access</button>
                </div>
            </div>
        </div>
    </dialog>

    {# Flash Messages — inline CSS #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div style="
                display:flex;align-items:center;gap:0.6rem;
                padding:0.85rem 1.1rem;border-radius:0.6rem;
                font-size:0.875rem;font-weight:500;
                margin-bottom:1.25rem;max-width:56rem;margin-left:auto;margin-right:auto;
                {% if label == 'success' %}background:#f0fdf4;color:#166534;{% else %}background:#fff1f2;color:#9f1239;{% endif %}
            ">
                <i data-lucide="{% if label == 'success' %}check-circle{% else %}alert-circle{% endif %}" style="width:1.1rem;height:1.1rem;flex-shrink:0;"></i>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="max-w-4xl mx-auto pb-12">
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="p-6 md:p-8">
                <div class="mb-8">
                    <h3 class="text-lg font-bold text-slate-900">User Credentials &amp; Profile</h3>
                    <p class="text-sm text-slate-500 mt-1">Provide profile details, set a password, and manage their system authority.</p>
                </div>

                {{ form_start(form, {'attr': {'class': 'space-y-8', 'enctype': 'multipart/form-data'}}) }}
                    <input type="hidden" name="clearAvatar" id="clearAvatarInput" value="0">

                    <!-- Avatar and Credentials -->
                    <div class="flex flex-col md:flex-row gap-8 items-center md:items-start pb-8 border-b border-slate-100">
                        <div class="flex flex-col items-center gap-3">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Profile Avatar</label>
                            <label for="{{ form.avatarFile.vars.id }}" class="relative group rounded-full overflow-hidden bg-slate-50 flex items-center justify-center cursor-pointer transition-all shadow-inner" style="width:5rem;height:5rem;min-width:5rem;min-height:5rem;border:2px solid #e2e8f0;">
                                <div id="avatar-placeholder" class="text-xl font-bold text-slate-400 select-none {% if targetUser.avatar %}hidden{% endif %}">
                                    {{ targetUser.username|slice(0,2)|upper }}
                                </div>
                                <img id="avatar-preview" src="{% if targetUser.avatar %}{{ asset('uploads/avatars/' ~ targetUser.avatar) }}{% endif %}" class="w-full h-full object-cover {% if not targetUser.avatar %}hidden{% endif %} transition-transform group-hover:scale-105" alt="Avatar">
                                <div class="absolute inset-0 bg-slate-900/40 opacity-0 group-hover:opacity-100 flex flex-col items-center justify-center text-white transition-opacity duration-200">
                                    <i data-lucide="camera" class="w-5 h-5 mb-1"></i>
                                    <span class="text-[9px] font-medium uppercase tracking-wider">Change</span>
                                </div>
                            </label>
                            {{ form_widget(form.avatarFile, {'attr': {'class': 'sr-only', 'onchange': 'previewAvatar(this)'}}) }}
                            <button id="clear-avatar-button" type="button" onclick="clearAvatarSelection()" class="{% if not targetUser.avatar %}hidden{% endif %}" style="border:0;border-radius:0.5rem;background:#fee2e2;color:#b91c1c;padding:0.45rem 0.75rem;font-size:0.75rem;font-weight:700;cursor:pointer;">
                                Clear Avatar
                            </button>
                            <p class="text-[10px] text-slate-400">JPG, PNG, WebP up to 2MB</p>
                            <div class="text-rose-500 text-xs font-medium mt-1">{{ form_errors(form.avatarFile) }}</div>
                        </div>

                        <div class="flex-1 w-full space-y-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div class="space-y-2">
                                    <label class="text-sm font-semibold text-slate-900">Username</label>
                                    {{ form_widget(form.username, {'attr': {'class': 'w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-4 focus:ring-slate-900/10 focus:border-slate-900 transition-all text-sm font-medium text-slate-900 placeholder-slate-400'}}) }}
                                    {{ form_errors(form.username) }}
                                </div>
                                <div class="space-y-2">
                                    <label class="text-sm font-semibold text-slate-900">Email Address</label>
                                    {{ form_widget(form.email, {'attr': {'class': 'w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-4 focus:ring-slate-900/10 focus:border-slate-900 transition-all text-sm font-medium text-slate-900 placeholder-slate-400'}}) }}
                                    {{ form_errors(form.email) }}
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div class="space-y-2">
                                    <label class="text-sm font-semibold text-slate-900">First Name</label>
                                    {{ form_widget(form.firstname, {'attr': {'class': 'w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-4 focus:ring-slate-900/10 focus:border-slate-900 transition-all text-sm font-medium text-slate-900 placeholder-slate-400'}}) }}
                                    {{ form_errors(form.firstname) }}
                                </div>
                                <div class="space-y-2">
                                    <label class="text-sm font-semibold text-slate-900">Last Name</label>
                                    {{ form_widget(form.lastname, {'attr': {'class': 'w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-4 focus:ring-slate-900/10 focus:border-slate-900 transition-all text-sm font-medium text-slate-900 placeholder-slate-400'}}) }}
                                    {{ form_errors(form.lastname) }}
                                </div>
                            </div>

                            <div class="space-y-2">
                                <label class="text-sm font-semibold text-slate-900">New Password</label>
                                {{ form_widget(form.plainPassword, {'attr': {'class': 'w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-4 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-sm font-medium text-slate-900 placeholder-slate-400'}}) }}
                                <p class="text-xs text-slate-400 mt-1">Leave blank to keep the current password.</p>
                                {{ form_errors(form.plainPassword) }}
                            </div>
                        </div>
                    </div>

                    <!-- Additional Details -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pb-8 border-b border-slate-100">
                        <div class="space-y-2">
                            <label class="text-sm font-semibold text-slate-900">Address</label>
                            {{ form_widget(form.address, {'attr': {'class': 'w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-4 focus:ring-slate-900/10 focus:border-slate-900 transition-all text-sm font-medium text-slate-900 placeholder-slate-400', 'rows': '2'}}) }}
                            {{ form_errors(form.address) }}
                        </div>
                        <div class="space-y-2">
                            <label class="text-sm font-semibold text-slate-900">Admin Note</label>
                            {{ form_widget(form.note, {'attr': {'class': 'w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-4 focus:ring-slate-900/10 focus:border-slate-900 transition-all text-sm font-medium text-slate-900 placeholder-slate-400', 'rows': '2'}}) }}
                            {{ form_errors(form.note) }}
                        </div>
                    </div>

                    <!-- Role and Permissions Configuration -->
                    <div class="space-y-6">
                        <div class="mb-4">
                            <h3 class="text-lg font-bold text-slate-900">Permissions &amp; Roles</h3>
                            <p class="text-sm text-slate-500 mt-1">Grant full administrator access or allocate specific granular permissions.</p>
                        </div>

                        <!-- Admin Role Checkbox — pure inline style -->
                        <div class="admin-role-banner" style="display:flex;align-items:flex-start;gap:1rem;">
                            <div style="display:flex;align-items:center;height:1.25rem;margin-top:0.125rem;">
                                {% set admin_checkbox_attrs = {'class': 'w-4 h-4 text-indigo-600 border-slate-300 rounded focus:ring-indigo-500'} %}
                                {% if is_self_admin_edit %}
                                    {% set admin_checkbox_attrs = admin_checkbox_attrs|merge({'disabled': 'disabled', 'style': 'cursor:not-allowed;'}) %}
                                    <input type="hidden" name="{{ form.isAdmin.vars.full_name }}" value="1">
                                {% endif %}
                                {{ form_widget(form.isAdmin, {'attr': admin_checkbox_attrs}) }}
                            </div>
                            <div style="flex:1;">
                                <label for="{{ form.isAdmin.vars.id }}" style="font-size:0.875rem;font-weight:700;color:#0f172a;{% if is_self_admin_edit %}cursor:not-allowed;{% else %}cursor:pointer;{% endif %}">
                                    {{ form.isAdmin.vars.label }}
                                </label>
                                {% if is_self_admin_edit %}
                                    <p style="font-size:0.75rem;color:#b45309;margin-top:0.25rem;font-weight:600;">You cannot remove administrator privileges from your own account.</p>
                                {% else %}
                                    <p style="font-size:0.75rem;color:#64748b;margin-top:0.25rem;">Checking this automatically bypasses all permissions checkpoints and grants full access to the sidebar menus and data tables.</p>
                                {% endif %}
                            </div>
                        </div>

                        <!-- CSS Grid layout style for checkboxes -->
                        <style>
                            .perm-table th, .perm-table td {
                                padding: 0.85rem 1rem;
                                vertical-align: middle;
                            }
                            html.dark .perm-table tr:hover {
                                background-color: rgba(51, 65, 85, 0.15) !important;
                            }
                        </style>

                        <!-- Granular Permissions Section -->
                        <div id="permissions-container" class="space-y-6 transition-all duration-200">
                            {% set perm_fields = {} %}
                            {% for child in form.permissions %}
                                {% set perm_name = child.vars.label %}
                                {% set perm_fields = perm_fields|merge({ (perm_name): child }) %}
                            {% endfor %}

                            <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                                <table class="w-full text-left border-collapse text-sm perm-table">
                                    <thead>
                                        <tr class="border-b border-slate-200 bg-slate-50/50">
                                            <th class="font-bold text-slate-700 w-2/5">Module / Resource</th>
                                            <th class="font-bold text-indigo-600 text-center w-15">View</th>
                                            <th class="font-bold text-emerald-600 text-center w-15">Add</th>
                                            <th class="font-bold text-amber-600 text-center w-15">Edit</th>
                                            <th class="font-bold text-rose-600 text-center w-15">Delete</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100">
                                        <!-- Row: Dashboard -->
                                        <tr class="hover:bg-slate-50/30 transition-colors">
                                            <td class="font-semibold text-slate-900 flex items-center gap-2">
                                                <i data-lucide="layout-dashboard" class="w-4 h-4 text-slate-400"></i>
                                                <span>Dashboard</span>
                                            </td>
                                            <td class="text-center">
                                                {% if perm_fields['see.dashboard'] is defined %}
                                                    {% set cb = perm_fields['see.dashboard'] %}
                                                    <div class="inline-flex items-center justify-center">
                                                        {{ form_widget(cb, {'attr': {'class': 'w-4 h-4 text-indigo-600 border-slate-300 rounded focus:ring-indigo-500'}}) }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                            <td class="text-center text-slate-300 dark:text-slate-600 font-mono text-xs">—</td>
                                            <td class="text-center text-slate-300 dark:text-slate-600 font-mono text-xs">—</td>
                                            <td class="text-center text-slate-300 dark:text-slate-600 font-mono text-xs">—</td>
                                        </tr>

                                        <!-- Row: Purchases (Parent) -->
                                        <tr class="hover:bg-slate-50/30 transition-colors bg-slate-50/20">
                                            <td class="font-bold text-slate-900 flex items-center gap-2">
                                                <i data-lucide="shopping-cart" class="w-4 h-4 text-indigo-600"></i>
                                                <span>Purchases (All Module)</span>
                                            </td>
                                            <td class="text-center">
                                                {% if perm_fields['see.purchases'] is defined %}
                                                    {% set cb = perm_fields['see.purchases'] %}
                                                    <div class="inline-flex items-center justify-center">
                                                        {{ form_widget(cb, {'attr': {'class': 'w-4 h-4 text-indigo-600 border-slate-300 rounded focus:ring-indigo-500 purchase-parent-checkbox'}}) }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                            <td class="text-center">
                                                {% if perm_fields['add.purchases'] is defined %}
                                                    {% set cb = perm_fields['add.purchases'] %}
                                                    <div class="inline-flex items-center justify-center">
                                                        {{ form_widget(cb, {'attr': {'class': 'w-4 h-4 text-emerald-600 border-slate-300 rounded focus:ring-emerald-500'}}) }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                            <td class="text-center">
                                                {% if perm_fields['edit.purchases'] is defined %}
                                                    {% set cb = perm_fields['edit.purchases'] %}
                                                    <div class="inline-flex items-center justify-center">
                                                        {{ form_widget(cb, {'attr': {'class': 'w-4 h-4 text-amber-600 border-slate-300 rounded focus:ring-amber-500'}}) }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                            <td class="text-center">
                                                {% if perm_fields['delete.purchases'] is defined %}
                                                    {% set cb = perm_fields['delete.purchases'] %}
                                                    <div class="inline-flex items-center justify-center">
                                                        {{ form_widget(cb, {'attr': {'class': 'w-4 h-4 text-rose-600 border-slate-300 rounded focus:ring-rose-500'}}) }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                        </tr>

                                        <!-- Row: Purchases -> Overview -->
                                        <tr class="hover:bg-slate-50/30 transition-colors">
                                            <td class="text-slate-600 pl-8 flex items-center gap-2">
                                                <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-600"></span>
                                                <span>Purchase Overview</span>
                                            </td>
                                            <td class="text-center">
                                                {% if perm_fields['see.purchase.overview'] is defined %}
                                                    {% set cb = perm_fields['see.purchase.overview'] %}
                                                    <div class="inline-flex items-center justify-center">
                                                        {{ form_widget(cb, {'attr': {'class': 'w-4 h-4 text-indigo-600 border-slate-300 rounded focus:ring-indigo-500 purchase-child-checkbox'}}) }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                            <td class="text-center text-slate-300 dark:text-slate-600 font-mono text-xs">—</td>
                                            <td class="text-center text-slate-300 dark:text-slate-600 font-mono text-xs">—</td>
                                            <td class="text-center text-slate-300 dark:text-slate-600 font-mono text-xs">—</td>
                                        </tr>

                                        <!-- Row: Purchases -> Purchase List -->
                                        <tr class="hover:bg-slate-50/30 transition-colors">
                                            <td class="text-slate-600 pl-8 flex items-center gap-2">
                                                <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-600"></span>
                                                <span>Purchase List</span>
                                            </td>
                                            <td class="text-center">
                                                {% if perm_fields['see.purchase.list'] is defined %}
                                                    {% set cb = perm_fields['see.purchase.list'] %}
                                                    <div class="inline-flex items-center justify-center">
                                                        {{ form_widget(cb, {'attr': {'class': 'w-4 h-4 text-indigo-600 border-slate-300 rounded focus:ring-indigo-500 purchase-child-checkbox'}}) }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                            <td class="text-center text-slate-300 dark:text-slate-600 font-mono text-xs">—</td>
                                            <td class="text-center text-slate-300 dark:text-slate-600 font-mono text-xs">—</td>
                                            <td class="text-center text-slate-300 dark:text-slate-600 font-mono text-xs">—</td>
                                        </tr>

                                        <!-- Row: Purchases -> Suppliers -->
                                        <tr class="hover:bg-slate-50/30 transition-colors">
                                            <td class="text-slate-600 pl-8 flex items-center gap-2">
                                                <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-600"></span>
                                                <span>Suppliers &amp; Contacts</span>
                                            </td>
                                            <td class="text-center">
                                                {% if perm_fields['see.purchase.suppliers'] is defined %}
                                                    {% set cb = perm_fields['see.purchase.suppliers'] %}
                                                    <div class="inline-flex items-center justify-center">
                                                        {{ form_widget(cb, {'attr': {'class': 'w-4 h-4 text-indigo-600 border-slate-300 rounded focus:ring-indigo-500 purchase-child-checkbox'}}) }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                            <td class="text-center">
                                                {% if perm_fields['add.suppliers'] is defined %}
                                                    {% set cb = perm_fields['add.suppliers'] %}
                                                    <div class="inline-flex items-center justify-center">
                                                        {{ form_widget(cb, {'attr': {'class': 'w-4 h-4 text-emerald-600 border-slate-300 rounded focus:ring-emerald-500'}}) }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                            <td class="text-center">
                                                {% if perm_fields['edit.suppliers'] is defined %}
                                                    {% set cb = perm_fields['edit.suppliers'] %}
                                                    <div class="inline-flex items-center justify-center">
                                                        {{ form_widget(cb, {'attr': {'class': 'w-4 h-4 text-amber-600 border-slate-300 rounded focus:ring-amber-500'}}) }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                            <td class="text-center">
                                                {% if perm_fields['delete.suppliers'] is defined %}
                                                    {% set cb = perm_fields['delete.suppliers'] %}
                                                    <div class="inline-flex items-center justify-center">
                                                        {{ form_widget(cb, {'attr': {'class': 'w-4 h-4 text-rose-600 border-slate-300 rounded focus:ring-rose-500'}}) }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                        </tr>

                                        <!-- Row: Sales (Parent) -->
                                        <tr class="hover:bg-slate-50/30 transition-colors bg-slate-50/20">
                                            <td class="font-bold text-slate-900 flex items-center gap-2">
                                                <i data-lucide="banknote" class="w-4 h-4 text-indigo-600"></i>
                                                <span>Sales (All Module)</span>
                                            </td>
                                            <td class="text-center">
                                                {% if perm_fields['see.sales'] is defined %}
                                                    {% set cb = perm_fields['see.sales'] %}
                                                    <div class="inline-flex items-center justify-center">
                                                        {{ form_widget(cb, {'attr': {'class': 'w-4 h-4 text-indigo-600 border-slate-300 rounded focus:ring-indigo-500 sale-parent-checkbox'}}) }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                            <td class="text-center">
                                                {% if perm_fields['add.sales'] is defined %}
                                                    {% set cb = perm_fields['add.sales'] %}
                                                    <div class="inline-flex items-center justify-center">
                                                        {{ form_widget(cb, {'attr': {'class': 'w-4 h-4 text-emerald-600 border-slate-300 rounded focus:ring-emerald-500'}}) }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                            <td class="text-center">
                                                {% if perm_fields['edit.sales'] is defined %}
                                                    {% set cb = perm_fields['edit.sales'] %}
                                                    <div class="inline-flex items-center justify-center">
                                                        {{ form_widget(cb, {'attr': {'class': 'w-4 h-4 text-amber-600 border-slate-300 rounded focus:ring-amber-500'}}) }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                            <td class="text-center">
                                                {% if perm_fields['delete.sales'] is defined %}
                                                    {% set cb = perm_fields['delete.sales'] %}
                                                    <div class="inline-flex items-center justify-center">
                                                        {{ form_widget(cb, {'attr': {'class': 'w-4 h-4 text-rose-600 border-slate-300 rounded focus:ring-rose-500'}}) }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                        </tr>

                                        <!-- Row: Sales -> Overview -->
                                        <tr class="hover:bg-slate-50/30 transition-colors">
                                            <td class="text-slate-600 pl-8 flex items-center gap-2">
                                                <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-600"></span>
                                                <span>Sales Overview</span>
                                            </td>
                                            <td class="text-center">
                                                {% if perm_fields['see.sale.overview'] is defined %}
                                                    {% set cb = perm_fields['see.sale.overview'] %}
                                                    <div class="inline-flex items-center justify-center">
                                                        {{ form_widget(cb, {'attr': {'class': 'w-4 h-4 text-indigo-600 border-slate-300 rounded focus:ring-indigo-500 sale-child-checkbox'}}) }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                            <td class="text-center text-slate-300 dark:text-slate-600 font-mono text-xs">—</td>
                                            <td class="text-center text-slate-300 dark:text-slate-600 font-mono text-xs">—</td>
                                            <td class="text-center text-slate-300 dark:text-slate-600 font-mono text-xs">—</td>
                                        </tr>

                                        <!-- Row: Sales -> Sales List -->
                                        <tr class="hover:bg-slate-50/30 transition-colors">
                                            <td class="text-slate-600 pl-8 flex items-center gap-2">
                                                <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-600"></span>
                                                <span>Sales List</span>
                                            </td>
                                            <td class="text-center">
                                                {% if perm_fields['see.sale.list'] is defined %}
                                                    {% set cb = perm_fields['see.sale.list'] %}
