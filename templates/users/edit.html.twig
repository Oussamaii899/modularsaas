                <script>
                    function previewAvatar(input) {
                        if (input.files && input.files[0]) {
                            const reader = new FileReader();
                            reader.onload = function(e) {
                                const preview = document.getElementById('avatar-preview');
                                const placeholder = document.getElementById('avatar-placeholder');
                                
                                preview.src = e.target.result;
                                preview.classList.remove('hidden');
                                if (placeholder) { placeholder.classList.add('hidden'); }
                                document.getElementById('clear-avatar-button')?.classList.remove('hidden');
                                document.getElementById('clearAvatarInput').value = '0';
                            }
                            reader.readAsDataURL(input.files[0]);
                        }
                    }

                    function clearAvatarSelection() {
                        const input = document.getElementById('{{ form.avatarFile.vars.id }}');
                        const preview = document.getElementById('avatar-preview');
                        const placeholder = document.getElementById('avatar-placeholder');
                        const clearButton = document.getElementById('clear-avatar-button');
                        const clearInput = document.getElementById('clearAvatarInput');

                        if (input) { input.value = ''; }
                        if (preview) { preview.src = ''; preview.classList.add('hidden'); }
                        placeholder?.classList.remove('hidden');
                        clearButton?.classList.add('hidden');
                        if (clearInput) { clearInput.value = '1'; }
                    }

                    function initGranularPermissionsSync() {
                        const purchaseParent = document.querySelector('.purchase-parent-checkbox');
                        const purchaseChildren = document.querySelectorAll('.purchase-child-checkbox');
                        const saleParent = document.querySelector('.sale-parent-checkbox');
                        const saleChildren = document.querySelectorAll('.sale-child-checkbox');

                        if (purchaseParent) {
                            purchaseParent.addEventListener('change', (e) => {
                                purchaseChildren.forEach(child => {
                                    child.checked = e.target.checked;
                                });
                            });
                            purchaseChildren.forEach(child => {
                                child.addEventListener('change', () => {
                                    if (!child.checked) {
                                        purchaseParent.checked = false;
                                    } else {
                                        const allChecked = Array.from(purchaseChildren).every(c => c.checked);
                                        if (allChecked) {
                                            purchaseParent.checked = true;
                                        }
                                    }
                                });
                            });
                            // Sync on load
                            const allChecked = purchaseChildren.length > 0 && Array.from(purchaseChildren).every(c => c.checked);
                            if (allChecked) {
                                purchaseParent.checked = true;
                            }
                        }

                        if (saleParent) {
                            saleParent.addEventListener('change', (e) => {
                                saleChildren.forEach(child => {
                                    child.checked = e.target.checked;
                                });
                            });
                            saleChildren.forEach(child => {
                                child.addEventListener('change', () => {
                                    if (!child.checked) {
                                        saleParent.checked = false;
                                    } else {
                                        const allChecked = Array.from(saleChildren).every(c => c.checked);
                                        if (allChecked) {
                                            saleParent.checked = true;
                                        }
                                    }
                                });
                            });
                            // Sync on load
                            const allChecked = saleChildren.length > 0 && Array.from(saleChildren).every(c => c.checked);
                            if (allChecked) {
                                saleParent.checked = true;
                            }
                        }
                    }

                    function initAdminToggle() {
                        const isAdminCheckbox = document.getElementById('{{ form.isAdmin.vars.id }}');
                        const permissionsContainer = document.getElementById('permissions-container');
                        const permissionCheckboxes = document.querySelectorAll('#permissions-container input[type="checkbox"]');
                        const confirmDialog = document.getElementById('adminConfirmDialog');
                        const isSelfAdminEdit = {{ is_self_admin_edit ? 'true' : 'false' }};

                        function enablePermissions(uncheckAll) {
                            permissionsContainer.style.opacity = '1';
                            permissionsContainer.style.pointerEvents = 'auto';
                            permissionCheckboxes.forEach(cb => {
                                cb.disabled = false;
                                if (uncheckAll) cb.checked = false;
                            });
                        }

                        function disablePermissions() {
                            permissionsContainer.style.opacity = '0.4';
                            permissionsContainer.style.pointerEvents = 'none';
                            permissionCheckboxes.forEach(cb => {
                                cb.disabled = true;
                                cb.checked = true;
                            });
                        }

                        function updateState(showConfirm) {
                            if (isSelfAdminEdit) {
                                isAdminCheckbox.checked = true;
                                disablePermissions();
                                return;
                            }

                            if (isAdminCheckbox.checked) {
                                if (showConfirm) {
                                    isAdminCheckbox.checked = false;
                                    confirmDialog.showModal();
                                } else {
                                    disablePermissions();
                                }
                            } else {
                                enablePermissions(showConfirm);
                            }
                        }

                        if (isSelfAdminEdit) {
                            updateState(false);
                            return;
                        }

                        document.getElementById('adminConfirmOk').addEventListener('click', () => {
                            confirmDialog.close();
                            isAdminCheckbox.checked = true;
                            disablePermissions();
                        });

                        document.getElementById('adminConfirmCancel').addEventListener('click', () => {
                            confirmDialog.close();
                            isAdminCheckbox.checked = false;
                        });

                        isAdminCheckbox.addEventListener('change', () => updateState(true));
                        updateState(false); // init on load
                    }
                    document.addEventListener('DOMContentLoaded', () => {
                        initAdminToggle();
                        initGranularPermissionsSync();
                    });
                </script>
