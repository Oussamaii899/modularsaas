{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Users | {{ company_name ?? 'ModularSaaS' }}{% endblock %}

{% block content_title %}Users{% endblock %}
{% block content_subtitle %}Manage system users and access permissions{% endblock %}

{% block content_actions %}
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center w-full sm:w-auto gap-2 sm:gap-3">
        <!-- Search Bar -->
        <form action="{{ path('app_users_index') }}" method="get" class="relative flex-1 sm:flex-none">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                <i data-lucide="search" class="w-4 h-4 text-slate-400" style="margin-left: 10px;"></i>
            </div>
            <input type="text" name="q" value="{{ searchQuery|default('') }}" placeholder="Search users..." class="block w-full sm:w-[300px] h-10 pl-10 pr-4 py-2 text-sm bg-white border border-slate-200 rounded-lg placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all shadow-sm">
        </form>

        <a href="{{ path('app_users_new') }}" class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow hover:bg-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 transition-colors">
            <i data-lucide="plus-circle" class="w-4 h-4"></i>
            <span>Add User</span>
        </a>
    </div>
{% endblock %}

{% block main_content %}
    {% set perm_labels = {
        'see.dashboard': 'Dashboard View',
        'see.purchases': 'Purchases View (All)',
        'see.purchase.overview': 'Purchases Overview',
        'see.purchase.suppliers': 'Suppliers View',
        'see.purchase.list': 'Purchases List',
        'see.sales': 'Sales View (All)',
        'see.sale.overview': 'Sales Overview',
        'see.sale.clients': 'Clients View',
        'see.sale.list': 'Sales List',
        'see.products': 'Products View',
        'see.logs': 'Logs View',
        
        'add.suppliers': 'Add Suppliers',
        'add.purchases': 'Add Purchases',
        'add.clients': 'Add Clients',
        'add.sales': 'Add Sales',
        'add.products': 'Add Products',
        
        'edit.suppliers': 'Edit Suppliers',
        'edit.purchases': 'Edit Purchases',
        'edit.clients': 'Edit Clients',
        'edit.sales': 'Edit Sales',
        'edit.products': 'Edit Products',
        
        'delete.suppliers': 'Delete Suppliers',
        'delete.purchases': 'Delete Purchases',
        'delete.clients': 'Delete Clients',
        'delete.sales': 'Delete Sales',
        'delete.products': 'Delete Products'
    } %}

    {# Flash Messages — styled with pure inline CSS to avoid Tailwind compilation issues #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div style="
                display: flex;
                align-items: center;
                gap: 0.6rem;
                padding: 0.85rem 1.1rem;
                border-radius: 0.6rem;
                font-size: 0.875rem;
                font-weight: 500;
                margin-bottom: 1.25rem;
                {% if label == 'success' %}
                    background-color: #f0fdf4;
                    color: #166534;
                {% else %}
                    background-color: #fff1f2;
                    color: #9f1239;
                {% endif %}
            ">
                <i data-lucide="{% if label == 'success' %}check-circle{% else %}alert-circle{% endif %}" style="width:1.1rem;height:1.1rem;flex-shrink:0;"></i>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50/30 transition-colors pointer-events-none">
                        <th class="h-12 px-4 align-middle font-medium text-slate-500 text-left uppercase tracking-wider text-[11px]">User Info</th>
                        <th class="h-12 px-4 align-middle font-medium text-slate-500 text-left uppercase tracking-wider text-[11px]">Full Name</th>
                        <th class="h-12 px-4 align-middle font-medium text-slate-500 text-left uppercase tracking-wider text-[11px]">Role / Permissions</th>
                        <th class="h-12 px-4 align-middle font-medium text-slate-500 text-center uppercase tracking-wider text-[11px]">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for u in users %}
                        <tr class="hover:bg-slate-50/80 transition-colors group">
                            <td class="p-4 align-top">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full overflow-hidden flex-shrink-0 flex items-center justify-center bg-indigo-50 text-indigo-600 font-bold border border-indigo-100 shadow-sm">
                                        {% if u.avatar %}
                                            <img src="{{ asset('uploads/avatars/' ~ u.avatar) }}" class="w-full h-full object-cover" alt="{{ u.username }}">
                                        {% else %}
                                            <img src="https://ui-avatars.com/api/?name={{ u.username }}&background=6366f1&color=fff" class="w-full h-full object-cover" alt="{{ u.username }}">
                                        {% endif %}
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="font-bold text-slate-900 text-sm flex items-center gap-1.5">
                                            {{ u.username }}
                                            {% if u == app.user %}
                                                <span class="inline-flex px-1.5 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-600">You</span>
                                            {% endif %}
                                        </span>
                                        <span class="text-xs text-slate-500 mt-0.5">{{ u.email }}</span>
                                    </div>
                                </div>
                            </td>
                            <td class="p-4 align-top text-slate-600 text-sm">
                                {{ u.firstname }} {{ u.lastname }}
                            </td>
                            <td class="p-4 align-top max-w-[400px]">
                                {% if 'ROLE_ADMIN' in u.roles %}
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold" style="background-color:#eef2ff;color:#4338ca;">
                                        Administrator
                                    </span>
                                {% else %}
                                    {% if u.permissionUsers is empty %}
                                        <span class="text-xs text-slate-400 italic">No permissions assigned</span>
                                    {% else %}
                                        <div class="flex flex-wrap gap-1">
                                            {% for permUser in u.permissionUsers %}
                                                {% set name = permUser.permission.name %}
                                                {% if name starts with 'see.' %}
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium" style="background:#eef2ff;color:#4338ca;">{{ perm_labels[name]|default(name) }}</span>
                                                {% elseif name starts with 'add.' %}
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium" style="background:#f0fdf4;color:#15803d;">{{ perm_labels[name]|default(name) }}</span>
                                                {% elseif name starts with 'edit.' %}
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium" style="background:#fffbeb;color:#b45309;">{{ perm_labels[name]|default(name) }}</span>
                                                {% elseif name starts with 'delete.' %}
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium" style="background:#fff1f2;color:#be123c;">{{ perm_labels[name]|default(name) }}</span>
                                                {% else %}
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium" style="background:#f8fafc;color:#475569;">{{ perm_labels[name]|default(name) }}</span>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td class="p-4 align-top text-center">
                                <div class="flex items-center justify-center gap-1">
                                    <a href="{{ path('app_users_edit', {'id': u.id}) }}" class="p-2 text-slate-400 hover:text-amber-600 hover:bg-amber-50 rounded-lg transition-all" title="Edit User">
                                        <i data-lucide="pencil" class="w-4.5 h-4.5"></i>
                                    </a>
                                    
                                    {% if u != app.user %}
                                        <button type="button" onclick="document.getElementById('deleteModal_{{ u.id }}').showModal()" class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all" title="Delete User">
                                            <i data-lucide="trash-2" class="w-4.5 h-4.5"></i>
                                        </button>

                                        <!-- Delete Modal -->
                                        <dialog id="deleteModal_{{ u.id }}" class="m-auto border-0 p-0 rounded-xl shadow-2xl max-w-md w-full overflow-hidden bg-white dark:bg-slate-800 backdrop:bg-slate-900/40 backdrop:backdrop-blur-sm">
                                            <div class="p-6 text-left text-slate-900 dark:text-slate-100 bg-white dark:bg-slate-800">
                                                <div class="flex items-start gap-4 mb-5">
                                                    <div class="w-10 h-10 rounded-full bg-rose-100 dark:bg-rose-950/30 flex items-center justify-center flex-shrink-0">
                                                        <i data-lucide="alert-circle" class="w-5 h-5 text-rose-600 dark:text-rose-400"></i>
                                                    </div>
                                                    <div class="flex-1">
                                                        <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 mb-2 leading-snug">Delete user {{ u.username }}?</h3>
                                                        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">This action cannot be undone. All access permissions for this user will be revoked, and their profile will be permanently deleted.</p>
                                                    </div>
                                                </div>
                                                <div class="flex justify-end gap-3 mt-6">
                                                    <button type="button" onclick="document.getElementById('deleteModal_{{ u.id }}').close()" class="px-4 py-2 text-sm font-semibold text-slate-700 dark:text-slate-300 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">Cancel</button>
                                                    <form method="post" action="{{ path('app_users_delete', {'id': u.id}) }}" class="inline m-0">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ u.id) }}">
                                                        <button type="submit" class="px-4 py-2 text-sm font-bold text-white bg-red-600 hover:bg-red-700 rounded-lg shadow-sm transition-colors active:scale-95">Delete User</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </dialog>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="p-8 text-center text-slate-400 italic">No users found matching your search.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% include 'components/_pagination.html.twig' with {
        items: users,
        pagesCount: pagesCount|default(1),
        currentPage: currentPage|default(1),
        totalItems: totalItems|default(0)
    } %}
{% endblock %}
